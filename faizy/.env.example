# Faizy — environment reference. Copy to .env.local in each app, or set these in
# Vercel/Supabase project settings. NEVER commit a filled-in copy.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public: safe in the browser. Every access it makes is gated by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. No NEXT_PUBLIC_ prefix, so Next.js will not
# inline it into client bundles. If this ever reaches a browser, rotate it.
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp notifications ──────────────────────────────────────────────────
# 'meta' (recommended) | 'twilio'. See docs/00-decisions.md §2.
WHATSAPP_PROVIDER=meta

# Meta Cloud API
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Twilio — also required for OTP delivery regardless of the provider above,
# because Supabase Auth's phone provider goes through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGE_SERVICE_SID=
TWILIO_WHATSAPP_FROM=+
# JSON map of template name -> Twilio Content SID, e.g.
# {"booking_confirmation":"HXxxxx","order_receipt":"HXyyyy"}
TWILIO_CONTENT_SIDS={}

# Shared secret for the queue-drain endpoint. Generate: openssl rand -hex 32
DRAIN_SECRET=

# ── Payments ────────────────────────────────────────────────────────────────
# ⚠️ Gateway not yet chosen — awaiting sign-off (docs/00-decisions.md §3).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
