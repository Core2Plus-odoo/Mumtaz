<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Settings: who holds each role ───────────────────────────────── -->
    <record id="res_config_settings_view_form_faizy_routing" model="ir.ui.view">
        <field name="name">res.config.settings.faizy.routing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="FAIZY" string="FAIZY" name="faizy_ai"
                     logo="/faizy_core/static/description/icon.png"
                     groups="faizy_core.group_faizy_manager">
                    <block title="Work routing" name="faizy_routing">
                        <setting string="Customer care approver"
                                 help="Reply approvals, inbound messages, completion messages.">
                            <field name="faizy_care_user_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Operations approver"
                                 help="New orders, order drafts, overdue jobs, proof review, applications.">
                            <field name="faizy_ops_user_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Escalation owner"
                                 help="Escalations, and anything left overdue.">
                            <field name="faizy_escalation_user_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- ── Activity type form: the escalation windows ─────────────────── -->
    <record id="mail_activity_type_view_form_faizy" model="ir.ui.view">
        <field name="name">mail.activity.type.form.faizy</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="mail.mail_activity_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="FAIZY routing" groups="faizy_core.group_faizy_manager">
                    <field name="faizy_route"/>
                    <field name="faizy_escalation_hours" invisible="not faizy_route"/>
                    <field name="faizy_urgent_escalation_hours" invisible="not faizy_route"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ── Shared: FAIZY work items ──────────────────────────────────────
         Standard activity list and kanban; clicking a row opens the record
         itself (open_target views), where the approve/assign button is.    -->
    <record id="mail_activity_view_search_faizy" model="ir.ui.view">
        <field name="name">mail.activity.search.faizy</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="activity_type_id"/>
                <field name="user_id"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <filter name="escalated" string="Escalated" domain="[('faizy_escalated', '=', True)]"/>
                <filter name="late" string="Overdue"
                        domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'activity_type_id'}"/>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_faizy_my_work" model="ir.actions.act_window">
        <field name="name">My work today</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban</field>
        <field name="view_id" ref="mail.mail_activity_view_tree_open_target"/>
        <field name="search_view_id" ref="mail_activity_view_search_faizy"/>
        <field name="domain">[('user_id', '=', uid), ('activity_type_id.faizy_route', '=', True)]</field>
        <field name="context">{'search_default_group_type': 1, 'force_search_count': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting for you.</p>
        </field>
    </record>

    <record id="action_faizy_all_work" model="ir.actions.act_window">
        <field name="name">Cross-team board</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban</field>
        <field name="view_id" ref="mail.mail_activity_view_tree_open_target"/>
        <field name="search_view_id" ref="mail_activity_view_search_faizy"/>
        <field name="domain">[('activity_type_id.faizy_route', '=', True)]</field>
        <field name="context">{'search_default_group_user': 1, 'force_search_count': 1}</field>
    </record>

    <!-- ── Care Desk (Mashood) ─────────────────────────────────────────── -->
    <record id="action_care_replies_waiting" model="ir.actions.act_window">
        <field name="name">Replies awaiting approval</field>
        <field name="res_model">faizy.ai.draft</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'customer_message'), ('state', '=', 'draft')]</field>
        <field name="context">{'default_kind': 'customer_message'}</field>
    </record>
    <record id="action_care_to_send" model="ir.actions.act_window">
        <field name="name">Approved, to send by hand</field>
        <field name="res_model">faizy.ai.draft</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'to_send')]</field>
    </record>
    <record id="action_care_inbound" model="ir.actions.act_window">
        <field name="name">Inbound to handle</field>
        <field name="res_model">faizy.ai.inbound</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'new')]</field>
    </record>

    <!-- ── Operations Desk (Raza) ──────────────────────────────────────── -->
    <record id="action_ops_unassigned" model="ir.actions.act_window">
        <field name="name">Unassigned orders</field>
        <field name="res_model">faizy.order</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('state', '=', 'pending'), ('worker_id', '=', False), ('vendor_id', '=', False)]</field>
        <field name="context">{'order': 'priority desc, create_date asc'}</field>
    </record>
    <record id="action_ops_order_drafts" model="ir.actions.act_window">
        <field name="name">Order drafts awaiting approval</field>
        <field name="res_model">faizy.ai.draft</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', 'in', ('order_create', 'order_update')), ('state', '=', 'draft')]</field>
    </record>
    <record id="action_ops_not_started" model="ir.actions.act_window">
        <field name="name">Jobs not started</field>
        <field name="res_model">faizy.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('assigned', 'scheduled')), ('scheduled_date', '!=', False), ('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d 23:59:59'))]</field>
    </record>
    <record id="action_ops_proof_review" model="ir.actions.act_window">
        <field name="name">Proof &amp; receipt review</field>
        <field name="res_model">faizy.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'in_progress')]</field>
    </record>

    <!-- ── Leads (§25): standard CRM, filtered to the signed-in salesperson ── -->
    <record id="action_faizy_my_leads" model="ir.actions.act_window">
        <field name="name">My leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'search_default_stage': 1, 'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No leads assigned to you.</p>
            <p>A lead's Salesperson is who works it. Each new lead gets a "Qualify lead"
               item on that person's desk, and a "Follow up lead" item once it is qualified.</p>
        </field>
    </record>
    <record id="action_faizy_leads_waiting" model="ir.actions.act_window">
        <field name="name">Leads waiting on me</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid), ('activity_ids.activity_type_id.faizy_route', '=', True)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No lead is waiting on you.</p>
        </field>
    </record>

    <!-- ── My desk: the numbers behind one person's day ──────────────────── -->
    <record id="view_faizy_my_desk_form" model="ir.ui.view">
        <field name="name">faizy.my.desk.form</field>
        <field name="model">faizy.my.desk</field>
        <field name="arch" type="xml">
            <form string="My desk" create="false" edit="false" class="o_faizy_dashboard">
                <field name="user_id" invisible="1"/>
                <field name="is_manager" invisible="1"/>
                <sheet>
                    <h1 class="fzb-title">My desk</h1>
                    <p class="fzb-sub">Your work today and this week. Every number opens the list behind it.</p>

                    <p class="fzb-band-title">Work items</p>
                    <div class="fzb-grid">
                        <button name="action_open_work" type="object" class="fzb-kpi fzb-attention">
                            <field name="work_open" nolabel="1"/>
                            <span class="fzb-kpi-sub">Open items on your desk</span>
                            <span class="fzb-kpi-label">Waiting for me</span>
                        </button>
                        <button name="action_open_work" type="object" class="fzb-kpi">
                            <field name="work_due_today" nolabel="1"/>
                            <span class="fzb-kpi-sub">Deadline is today</span>
                            <span class="fzb-kpi-label">Due today</span>
                        </button>
                        <button name="action_open_overdue" type="object" class="fzb-kpi fzb-attention">
                            <field name="work_overdue" nolabel="1"/>
                            <span class="fzb-kpi-sub">Past their deadline</span>
                            <span class="fzb-kpi-label">Overdue</span>
                        </button>
                        <button name="action_open_escalated" type="object" class="fzb-kpi fzb-attention">
                            <field name="work_escalated" nolabel="1"/>
                            <span class="fzb-kpi-sub">Already with the escalation owner</span>
                            <span class="fzb-kpi-label">Escalated</span>
                        </button>
                        <div class="fzb-kpi">
                            <field name="done_today" nolabel="1"/>
                            <span class="fzb-kpi-sub">Items you closed today</span>
                            <span class="fzb-kpi-label">Done today</span>
                        </div>
                        <div class="fzb-kpi">
                            <field name="done_week" nolabel="1"/>
                            <span class="fzb-kpi-sub">Items you closed since Monday</span>
                            <span class="fzb-kpi-label">Done this week</span>
                        </div>
                    </div>
                    <group string="Done this week, by type">
                        <field name="done_week_html" nolabel="1" colspan="2"/>
                    </group>

                    <p class="fzb-band-title">Planned work</p>
                    <div class="fzb-grid">
                        <button name="action_open_plan_today" type="object" class="fzb-kpi fzb-attention">
                            <field name="plan_due_today" nolabel="1"/>
                            <span class="fzb-kpi-sub">Tasks with today's deadline</span>
                            <span class="fzb-kpi-label">Plan: due today</span>
                        </button>
                        <button name="action_open_plan_today" type="object" class="fzb-kpi">
                            <field name="plan_hours_today" nolabel="1" widget="float_time"/>
                            <span class="fzb-kpi-sub">Allocated hours, today</span>
                            <span class="fzb-kpi-label">Plan: hours today</span>
                        </button>
                        <button name="action_open_plan_overdue" type="object" class="fzb-kpi fzb-attention">
                            <field name="plan_overdue" nolabel="1"/>
                            <span class="fzb-kpi-sub">Past their deadline, not done</span>
                            <span class="fzb-kpi-label">Plan: overdue</span>
                        </button>
                        <div class="fzb-kpi">
                            <field name="plan_done_week" nolabel="1"/>
                            <span class="fzb-kpi-sub">Since Monday, with evidence</span>
                            <span class="fzb-kpi-label">Plan: done this week</span>
                        </div>
                        <button name="action_open_plan" type="object" class="fzb-kpi">
                            <field name="plan_open" nolabel="1"/>
                            <span class="fzb-kpi-sub">Whole plan, still open</span>
                            <span class="fzb-kpi-label">Plan: open tasks</span>
                        </button>
                    </div>

                    <p class="fzb-band-title">Leads</p>
                    <div class="fzb-grid">
                        <button name="action_open_leads" type="object" class="fzb-kpi">
                            <field name="leads_mine" nolabel="1"/>
                            <span class="fzb-kpi-sub">Not yet won</span>
                            <span class="fzb-kpi-label">My open leads</span>
                        </button>
                        <button name="action_open_leads_waiting" type="object" class="fzb-kpi fzb-attention">
                            <field name="leads_waiting" nolabel="1"/>
                            <span class="fzb-kpi-sub">Qualify or follow up</span>
                            <span class="fzb-kpi-label">Leads waiting on me</span>
                        </button>
                        <div class="fzb-kpi">
                            <field name="leads_qualified_week" nolabel="1"/>
                            <span class="fzb-kpi-sub">Since Monday</span>
                            <span class="fzb-kpi-label">Leads I qualified</span>
                        </div>
                        <div class="fzb-kpi">
                            <field name="leads_won_month" nolabel="1"/>
                            <span class="fzb-kpi-sub">This month</span>
                            <span class="fzb-kpi-label">My leads won</span>
                        </div>
                    </div>

                    <p class="fzb-band-title">Outcomes</p>
                    <div class="fzb-grid">
                        <div class="fzb-kpi">
                            <field name="replies_week" nolabel="1"/>
                            <span class="fzb-kpi-sub">Since Monday</span>
                            <span class="fzb-kpi-label">Replies I approved</span>
                        </div>
                        <div class="fzb-kpi">
                            <field name="completion_msgs_week" nolabel="1"/>
                            <span class="fzb-kpi-sub">Since Monday</span>
                            <span class="fzb-kpi-label">Completion messages I sent</span>
                        </div>
                        <button name="action_open_orders_week" type="object" class="fzb-kpi">
                            <field name="orders_completed_week" nolabel="1"/>
                            <span class="fzb-kpi-sub">Whole team, since Monday</span>
                            <span class="fzb-kpi-label">Orders completed</span>
                        </button>
                    </div>

                    <group string="Team" invisible="not is_manager">
                        <field name="team_html" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_faizy_my_desk" model="ir.actions.act_window">
        <field name="name">My desk</field>
        <field name="res_model">faizy.my.desk</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ── Command Centre (Umer) ───────────────────────────────────────── -->
    <record id="action_cc_escalations" model="ir.actions.act_window">
        <field name="name">Escalations &amp; decisions</field>
        <field name="res_model">faizy.ai.draft</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kind', '=', 'other'), ('state', '=', 'draft')]</field>
    </record>

    <!-- ── Menus ───────────────────────────────────────────────────────── -->
    <menuitem id="menu_care_desk" name="Care Desk" sequence="10"
              web_icon="faizy_core,static/description/icon.png"
              groups="faizy_ai.group_comms,faizy_core.group_faizy_manager"/>
    <menuitem id="menu_care_my_work" name="My work today" parent="menu_care_desk"
              action="action_faizy_my_work" sequence="1"/>
    <menuitem id="menu_care_replies" name="Replies awaiting approval" parent="menu_care_desk"
              action="action_care_replies_waiting" sequence="2"/>
    <menuitem id="menu_care_to_send" name="To send by hand" parent="menu_care_desk"
              action="action_care_to_send" sequence="3"/>
    <menuitem id="menu_care_inbound" name="Inbound to handle" parent="menu_care_desk"
              action="action_care_inbound" sequence="4"/>
    <menuitem id="menu_care_leads" name="My leads" parent="menu_care_desk"
              action="action_faizy_my_leads" sequence="5"
              groups="faizy_ai.group_comms,faizy_core.group_faizy_manager"/>
    <menuitem id="menu_care_kpis" name="My desk (KPIs)" parent="menu_care_desk"
              action="action_faizy_my_desk" sequence="9"
              groups="faizy_ai.group_comms,faizy_core.group_faizy_manager"/>

    <menuitem id="menu_ops_desk" name="Operations Desk" sequence="11"
              web_icon="faizy_core,static/description/icon.png"
              groups="faizy_core.group_faizy_ops"/>
    <menuitem id="menu_ops_my_work" name="My work today" parent="menu_ops_desk"
              action="action_faizy_my_work" sequence="1"/>
    <menuitem id="menu_ops_unassigned" name="Unassigned orders" parent="menu_ops_desk"
              action="action_ops_unassigned" sequence="2"/>
    <menuitem id="menu_ops_drafts" name="Order drafts" parent="menu_ops_desk"
              action="action_ops_order_drafts" sequence="3"/>
    <menuitem id="menu_ops_not_started" name="Jobs not started" parent="menu_ops_desk"
              action="action_ops_not_started" sequence="4"/>
    <menuitem id="menu_ops_proof" name="Proof &amp; receipt review" parent="menu_ops_desk"
              action="action_ops_proof_review" sequence="5"/>
    <menuitem id="menu_ops_workers" name="Faizies" parent="menu_ops_desk"
              action="faizy_core.action_faizy_worker" sequence="6"/>
    <menuitem id="menu_ops_applications" name="Applications" parent="menu_ops_desk"
              action="faizy_core.action_faizy_application" sequence="7"/>
    <menuitem id="menu_ops_leads" name="My leads" parent="menu_ops_desk"
              action="action_faizy_my_leads" sequence="8" groups="faizy_core.group_faizy_ops"/>
    <menuitem id="menu_ops_kpis" name="My desk (KPIs)" parent="menu_ops_desk"
              action="action_faizy_my_desk" sequence="9" groups="faizy_core.group_faizy_ops"/>

    <menuitem id="menu_command_centre" name="Command Centre" sequence="12"
              web_icon="faizy_core,static/description/icon.png"
              groups="faizy_core.group_faizy_manager"/>
    <menuitem id="menu_cc_escalations" name="Escalations &amp; decisions" parent="menu_command_centre"
              action="action_cc_escalations" sequence="1"/>
    <menuitem id="menu_cc_my_work" name="My work today" parent="menu_command_centre"
              action="action_faizy_my_work" sequence="2"/>
    <menuitem id="menu_cc_board" name="Cross-team board" parent="menu_command_centre"
              action="action_faizy_all_work" sequence="3"/>
    <menuitem id="menu_cc_health" name="Operations health" parent="menu_command_centre"
              action="faizy_core.action_faizy_dashboard" sequence="4"/>
    <menuitem id="menu_cc_queue" name="All approvals" parent="menu_command_centre"
              action="action_faizy_ai_draft" sequence="5"/>
    <menuitem id="menu_cc_pipeline" name="Lead pipeline" parent="menu_command_centre"
              action="crm.crm_lead_action_pipeline" sequence="6" groups="faizy_core.group_faizy_manager"/>
    <menuitem id="menu_cc_kpis" name="My desk &amp; team KPIs" parent="menu_command_centre"
              action="action_faizy_my_desk" sequence="7" groups="faizy_core.group_faizy_manager"/>
</odoo>
