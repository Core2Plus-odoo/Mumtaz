<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read access to faizy_core models for the AI agent group and the comms approver.
         Kept in XML (not the CSV) because these models belong to faizy_core. -->
    <record id="access_order_ai" model="ir.model.access">
        <field name="name">faizy.order read ai agent</field>
        <field name="model_id" ref="faizy_core.model_faizy_order"/>
        <field name="group_id" ref="group_ai_agent"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
