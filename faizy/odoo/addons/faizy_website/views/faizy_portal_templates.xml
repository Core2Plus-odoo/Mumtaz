<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cards on the portal home. -->
    <template id="portal_my_home_faizy" name="Portal: Faizy entries"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/faizy_website/static/src/img/portal-family.svg'"/>
                <t t-set="title">My Family</t>
                <t t-set="text">Who we are caring for</t>
                <t t-set="url" t-value="'/care'"/>
                <t t-set="placeholder_count" t-value="'faizy_family_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/faizy_website/static/src/img/portal-orders.svg'"/>
                <t t-set="title">Care Orders</t>
                <t t-set="text">Every task, with proof</t>
                <t t-set="url" t-value="'/care/orders'"/>
                <t t-set="placeholder_count" t-value="'faizy_order_count'"/>
            </t>
        </xpath>
    </template>

    <!-- ── Installable web app ──────────────────────────────────────────
         Four tags and a manifest are the whole difference between a page in
         a browser tab and an icon on the home screen that opens full-screen.
         Site-wide rather than portal-only: someone who signs up at /start
         should be able to keep Faizy on their phone straight away.

         `apple-mobile-web-app-capable` is the deprecated spelling iOS still
         needs; `mobile-web-app-capable` is the standard one. Both, because
         dropping either loses a platform. -->
    <template id="faizy_app_head" name="Faizy — web app head"
              inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <link rel="manifest" href="/faizy/manifest.webmanifest"/>
            <meta name="theme-color" content="#fdf8f0"/>
            <meta name="mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
            <meta name="apple-mobile-web-app-title" content="Faizy"/>
            <link rel="apple-touch-icon"
                  href="/faizy_website/static/src/img/icon-180.png"/>
        </xpath>
    </template>

    <!-- The WhatsApp glyph, in one place so the portal cannot drift from the
         header's. -->
    <template id="portal_wa_icon" name="Faizy — WhatsApp icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.2.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.6-.4zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2z"/></svg>
    </template>

    <!-- ── Bottom tab bar ───────────────────────────────────────────────
         Phone only. On a phone the top of the screen is the hardest place to
         reach and the site header is up there with a dropdown in it; an app
         puts its navigation under the thumb. Hidden from 768px up, where the
         site header is already a usable navigation.

         `role="navigation"` and a real <a> per tab, not JS: this has to work
         on a cheap Android with a bad connection. -->
    <template id="portal_tabbar" name="Faizy — Portal tab bar">
        <nav class="fzp-tabbar" role="navigation" aria-label="Faizy">
            <a t-attf-class="fzp-tab #{page_name == 'faizy_care' and 'is-on' or ''}"
               href="/care">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                <span>Care</span>
            </a>
            <a t-attf-class="fzp-tab #{page_name == 'faizy_orders' and 'is-on' or ''}"
               href="/care/orders">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v3H4zm0 5h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1zm5 4v2h6v-2z"/></svg>
                <span>Orders</span>
            </a>
            <!-- The primary action, emphasised, in the middle where a thumb
                 lands. Account is not a tab: it is reachable from the site
                 header's user menu, and a nav that offers four equal choices
                 hides the one the customer actually came to do. -->
            <a t-attf-class="fzp-tab is-primary #{page_name == 'faizy_request' and 'is-on' or ''}"
               href="/care/request">
                <span class="fzp-tab-plus" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg>
                </span>
                <span>Request</span>
            </a>
            <a t-if="wa_new_task" class="fzp-tab is-wa" t-att-href="wa_new_task"
               target="_blank" rel="noopener">
                <t t-call="faizy_website.portal_wa_icon"/>
                <span>Ask</span>
            </a>
        </nav>
    </template>

    <!-- The page header band. Shared so /care and /care/orders cannot drift. -->
    <template id="portal_page_head" name="Faizy — Portal header">
        <div class="fzp-head">
            <div>
                <p class="fzp-eyebrow" t-out="eyebrow"/>
                <h1 class="fzp-title" t-out="title"/>
            </div>
            <a t-if="wa_new_task" class="fzp-wa" t-att-href="wa_new_task"
               target="_blank" rel="noopener">
                <t t-call="faizy_website.portal_wa_icon"/>
                Message us on WhatsApp
            </a>
        </div>
    </template>

    <!-- ── One screen: how the family is, and what's left this month ──── -->
    <template id="portal_care_home" name="Faizy — My Care">
        <t t-call="website.layout">
            <t t-set="additional_title">Your care</t>
            <div id="wrap" class="faizy-page">
                <t t-call="portal.portal_back_in_edit_mode"/>

                <div class="fzp">
                  <div class="fzp-inner">

                    <t t-call="faizy_website.portal_page_head">
                        <t t-set="eyebrow">Your care dashboard</t>
                        <t t-set="title">Assalam o Alaikum, <t t-out="first_name"/></t>
                    </t>

                    <!-- The one thing a customer comes here to do, above the
                         fold and not hidden behind a WhatsApp round trip. -->
                    <a href="/care/request" class="fzp-cta">
                        <span class="fzp-cta-icon" aria-hidden="true">+</span>
                        <span>
                            <span class="fzp-cta-title">Request care</span>
                            <span class="fzp-cta-note">Medicines, bills, a visit — tell us what you need</span>
                        </span>
                    </a>

                    <!-- The numbers someone opens this page to check, before
                         any prose. -->
                    <div class="fzp-stats">
                        <!-- No activity counter here, deliberately. Metering is
                             the first thing a subscriber saw, and making someone
                             feel counted before they have asked for help is the
                             opposite of what this product is for. It lives at the
                             bottom of the page instead. Free activities stay:
                             that is an offer, not a meter. -->
                        <div t-if="not subscription" class="fzp-stat">
                            <p class="fzp-stat-label">Free activities left</p>
                            <div class="fzp-stat-value" t-out="partner.faizy_free_activities"></div>
                        </div>

                        <div class="fzp-stat">
                            <p class="fzp-stat-label">Family members</p>
                            <div class="fzp-stat-value" t-out="family_count"></div>
                        </div>

                        <div class="fzp-stat">
                            <p class="fzp-stat-label">Open care tasks</p>
                            <div class="fzp-stat-value" t-out="open_count"></div>
                        </div>

                        <div t-if="subscription" class="fzp-stat">
                            <p class="fzp-stat-label">Renews</p>
                            <div class="fzp-stat-value"
                                 t-out="subscription.period_end"
                                 t-options="{'widget': 'date'}"></div>
                        </div>
                    </div>

                    <div t-if="not subscription and partner.faizy_free_activities &gt; 0"
                         class="fzp-promo">
                        <div>
                            <h2>
                                You have <t t-out="partner.faizy_free_activities"/> free care activities
                            </h2>
                            <p>
                                Use them whenever you like — no card needed. Choose a plan
                                when you are ready for something regular.
                            </p>
                        </div>
                        <a href="/pricing" class="fzp-btn">See plans</a>
                    </div>

                    <!-- Out of free activities and no plan. The server already
                         refuses to confirm a booking in this state; saying so
                         here is the difference between the customer choosing a
                         plan and the customer waiting for an answer that never
                         comes. -->
                    <div t-if="not subscription and partner.faizy_free_activities &lt;= 0"
                         class="fzp-promo is-spent">
                        <div>
                            <h2>Your free activities are used up</h2>
                            <p>
                                We hope they were useful. Choose a plan to keep us
                                looking after your family — from PKR 1,999 a month,
                                cancel any time.
                            </p>
                        </div>
                        <a href="/pricing" class="fzp-btn">Choose a plan</a>
                    </div>

                    <!-- Family -->
                    <div class="fzp-section">
                        <h2>Your family</h2>
                        <a t-if="wa_add_member" class="fzp-link" t-att-href="wa_add_member"
                           target="_blank" rel="noopener">Add someone →</a>
                    </div>

                    <t t-foreach="family" t-as="member">
                        <div class="fzp-member">
                            <!-- Indexing, not .upper() — .fzp-avatar uppercases
                                 in CSS, so the template calls no string methods. -->
                            <div class="fzp-avatar" t-out="member.name and member.name[0] or '?'"></div>
                            <div class="fzp-member-body">
                                <p class="fzp-member-name" t-out="member.name"/>
                                <p class="fzp-member-meta">
                                    <t t-out="dict(member._fields['relationship'].selection).get(member.relationship)"/>
                                    <t t-if="member.city"> · <t t-out="member.city"/></t>
                                </p>
                            </div>
                            <span class="faizy-fmb" t-out="member.fmb_id"/>
                        </div>
                    </t>

                    <div t-if="not family" class="fzp-table-wrap">
                        <div class="fzp-empty">
                            <div class="fzp-empty-icon">👪</div>
                            <h3>Nobody added yet</h3>
                            <p>
                                Tell us who we are looking after — a parent, a sibling, or
                                yourself — and we will set them up with their own Faizy ID.
                            </p>
                            <a t-if="wa_add_member" class="fzp-btn" t-att-href="wa_add_member"
                               target="_blank" rel="noopener">Add on WhatsApp</a>
                        </div>
                    </div>

                    <!-- Recent care -->
                    <div class="fzp-section">
                        <h2>Recent care</h2>
                        <a t-if="order_count" class="fzp-link" href="/care/orders">See all orders →</a>
                    </div>
                    <t t-call="faizy_website.portal_order_table">
                        <t t-set="orders" t-value="recent_orders"/>
                    </t>

                    <!-- Your plan, and what is left of it — at the foot of the
                         page rather than the head of it. -->
                    <div t-if="subscription" class="fzp-card">
                        <div class="fzp-plan-top">
                            <div>
                                <p class="fzp-meta">Your plan</p>
                                <h2 class="fzp-plan-name" t-out="subscription.plan_id.name"/>
                            </div>
                            <a t-if="wa_change_plan" class="fzp-link" t-att-href="wa_change_plan"
                               target="_blank" rel="noopener">Change plan →</a>
                        </div>

                        <div class="fzp-meter-row">
                            <span>Care activities used</span>
                            <span>
                                <t t-out="subscription.activities_used"/> of
                                <t t-out="subscription.activities_included"/>
                            </span>
                        </div>
                        <div class="fzp-meter">
                            <!-- Capped at 100% so an overage month does not
                                 render a bar wider than its track. -->
                            <div class="fzp-meter-fill"
                                 t-attf-style="width: #{min(100, subscription.activities_included and round(100.0 * subscription.activities_used / subscription.activities_included) or 0)}%;"></div>
                        </div>
                        <p class="fzp-meta mt-2 mb-0"
                           t-if="subscription.activities_used &gt; subscription.activities_included">
                            <!-- The subscription's currency, not the plan's: subscribers
                                 are billed in the currency published for their own
                                 market, so quoting the plan's would show a London
                                 customer a figure they will never be charged. -->
                            You are past this month's allowance. Extra activities are billed at
                            <span t-out="subscription.currency_id.name"/>
                            <span t-out="subscription.plan_id.overage_display(subscription.currency_id)"/> each.
                        </p>
                    </div>

                    <p class="fzp-foot-links">
                        <a class="fzp-link" href="/my/invoices">Your invoices →</a>
                    </p>

                  </div>
                </div>

                <t t-call="faizy_website.portal_tabbar"/>
            </div>
        </t>
    </template>

    <!-- Shared table so the list and the summary cannot drift. -->
    <template id="portal_order_table" name="Faizy — Order Table">
        <div class="fzp-table-wrap">
            <table t-if="orders" class="fzp-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Task</th>
                        <th>For</th>
                        <th>Date</th>
                        <th class="num">Total</th>
                        <th class="num">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="orders" t-as="order">
                        <tr>
                            <td>
                                <a class="fzp-ref" t-attf-href="/care/orders/#{order.id}"
                                   t-out="order.name"/>
                            </td>
                            <td class="fzp-task" t-out="order.title"/>
                            <td>
                                <span t-if="order.family_member_id" class="faizy-fmb"
                                      t-out="order.family_member_id.fmb_id"/>
                            </td>
                            <td t-out="order.create_date" t-options="{'widget': 'date'}"/>
                            <td class="num" t-out="order.amount_total"
                                t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                            <td class="num">
                                <span t-attf-class="faizy-status is-#{order.state}"
                                      t-out="dict(order._fields['state'].selection).get(order.state)"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- An empty portal is what every customer sees on day one, so it
                 has to say what will appear here and how to start it. -->
            <div t-if="not orders" class="fzp-empty">
                <div class="fzp-empty-icon">🌿</div>
                <h3>No care tasks yet</h3>
                <p>
                    When you ask us for something — a prescription collected, a bill
                    paid, a visit to check in — it will appear here with a photo once
                    it is done.
                </p>
                <a class="fzp-btn" href="/care/request">Request care</a>
                <a t-if="wa_new_task" class="fzp-link d-block mt-3" t-att-href="wa_new_task"
                   target="_blank" rel="noopener">or message us on WhatsApp →</a>
            </div>
        </div>
    </template>

    <template id="portal_orders" name="Faizy — My Orders">
        <t t-call="website.layout">
            <t t-set="additional_title">Care orders</t>
            <div id="wrap" class="faizy-page">
                <t t-call="portal.portal_back_in_edit_mode"/>

                <div class="fzp">
                  <div class="fzp-inner">
                    <t t-call="faizy_website.portal_page_head">
                        <t t-set="eyebrow">Your care history</t>
                        <t t-set="title">Care orders</t>
                    </t>

                    <t t-call="faizy_website.portal_order_table"/>

                    <div class="o_portal_pager text-center mt-4">
                        <t t-call="portal.pager"/>
                    </div>
                  </div>
                </div>

                <t t-call="faizy_website.portal_tabbar"/>
            </div>
        </t>
    </template>

    <!-- ── Request care ─────────────────────────────────────────────────
         Person first, then the task. A customer thinks "Ammi needs her BP
         medicine", not "I require service SKU-04", and asking for the service
         first makes them translate their own problem into our catalogue
         before we have helped with anything.

         Three numbered steps on one page rather than three screens: no JS, one
         POST, and the whole thing survives a bad connection and a back button.

         Every <textarea> and <input> is written closed. A self-closed
         <textarea/> makes an HTML parser swallow the rest of the document. -->
    <template id="portal_request_form" name="Faizy — Request Care">
        <t t-call="website.layout">
            <t t-set="additional_title">Request care</t>
            <div id="wrap" class="faizy-page">
                <t t-call="portal.portal_back_in_edit_mode"/>

                <div class="fzp">
                  <div class="fzp-inner">

                    <t t-call="faizy_website.portal_page_head">
                        <t t-set="eyebrow">Ask for help</t>
                        <t t-set="title">Who needs help?</t>
                    </t>

                    <div t-if="errors.get('__all__')" class="fzp-alert is-bad">
                        <t t-out="errors['__all__']"/>
                    </div>

                    <!-- No free activities left and no live plan. The server
                         refuses to confirm a booking in this state, so offering
                         the form would take a request we cannot act on. Said
                         here instead, where the customer can do something
                         about it. -->
                    <div t-if="needs_plan" class="fzp-gate">
                        <div class="fzp-gate-icon" aria-hidden="true">🌙</div>
                        <h2>You have used your free activities</h2>
                        <p>
                            We hope they helped. To keep asking us for medicines,
                            bills, visits and errands, choose a plan — from
                            PKR 1,999 a month, cancel any time.
                        </p>
                        <a href="/pricing" class="fzp-btn">Choose a plan</a>
                        <p t-if="wa_new_task" class="fzp-gate-alt">
                            Something urgent?
                            <a class="fzp-link" t-att-href="wa_new_task"
                               target="_blank" rel="noopener">Message us on WhatsApp</a>
                            and we will work it out.
                        </p>
                    </div>

                    <form t-if="not needs_plan" action="/care/request/submit" method="post">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <!-- 1 · The person -->
                        <div class="fzp-step">
                            <p class="fzp-step-label">1 · Who is it for?</p>
                            <p t-if="errors.get('family_member_id')" class="fzp-error"
                               t-out="errors['family_member_id']"/>

                            <div class="fzp-picker is-tight">
                                <t t-foreach="member_rows" t-as="row">
                                    <label class="fzp-pick">
                                        <input type="radio" name="family_member_id"
                                               t-att-value="row['member'].id"
                                               t-att-checked="post.get('family_member_id') == str(row['member'].id) or None"/>
                                        <span class="fzp-pick-body">
                                            <span class="fzp-pick-head">
                                                <span class="fzp-avatar fzp-avatar--sm"
                                                      t-out="row['member'].name and row['member'].name[0] or '?'"></span>
                                                <span>
                                                    <span class="fzp-pick-name" t-out="row['member'].name"></span>
                                                    <span class="fzp-pick-note">
                                                        <t t-out="dict(row['member']._fields['relationship'].selection).get(row['member'].relationship)"/>
                                                        <t t-if="row['member'].city"> · <t t-out="row['member'].city"/></t>
                                                    </span>
                                                </span>
                                            </span>
                                            <!-- Derived from their own orders, so it can never go
                                                 stale the way a field somebody has to update would. -->
                                            <span t-if="row['hint']"
                                                  t-attf-class="fzp-hint is-#{row['tone']}"
                                                  t-out="row['hint']"></span>
                                        </span>
                                    </label>
                                </t>

                                <label class="fzp-pick">
                                    <input type="radio" name="family_member_id" value=""
                                           t-att-checked="not post.get('family_member_id') or None"/>
                                    <span class="fzp-pick-body">
                                        <span class="fzp-pick-head">
                                            <span class="fzp-avatar fzp-avatar--sm">·</span>
                                            <span>
                                                <span class="fzp-pick-name">The household</span>
                                                <span class="fzp-pick-note">Not for one person in particular</span>
                                            </span>
                                        </span>
                                    </span>
                                </label>
                            </div>

                            <p t-if="not family" class="fzp-meta mb-0">
                                Nobody is set up yet — we can still help, and we will add
                                them for you.
                                <a t-if="wa_add_member" class="fzp-link" t-att-href="wa_add_member"
                                   target="_blank" rel="noopener">Add someone →</a>
                            </p>
                        </div>

                        <!-- 2 · The task -->
                        <div class="fzp-step">
                            <p class="fzp-step-label">2 · What do you need?</p>
                            <p t-if="errors.get('service_id')" class="fzp-error"
                               t-out="errors['service_id']"/>

                            <t t-foreach="categories" t-as="category">
                                <p t-if="category.service_ids" class="fzp-group-title"
                                   t-out="category.name"></p>
                                <div t-if="category.service_ids" class="fzp-picker">
                                    <t t-foreach="category.service_ids" t-as="service">
                                        <label t-if="service.active" class="fzp-pick">
                                            <input type="radio" name="service_id"
                                                   t-att-value="service.id"
                                                   t-att-checked="post.get('service_id') == str(service.id) or None"/>
                                            <span class="fzp-pick-body">
                                                <span class="fzp-pick-head">
                                                    <span class="fzp-sico"
                                                          t-out="service.icon or category.icon or '•'"></span>
                                                    <span>
                                                        <span class="fzp-pick-name" t-out="service.name"></span>
                                                        <span t-if="service.description" class="fzp-pick-note"
                                                              t-out="service.description"></span>
                                                    </span>
                                                </span>
                                            </span>
                                        </label>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <!-- 3 · The details -->
                        <div class="fzp-step">
                            <p class="fzp-step-label">3 · Anything we should know?</p>

                            <div class="fzp-field">
                                <label class="fzp-label" for="fzp-city">Which city?</label>
                                <p t-if="errors.get('city')" class="fzp-error" t-out="errors['city']"/>
                                <input id="fzp-city" class="fzp-input" type="text" name="city"
                                       placeholder="Karachi" required="required"
                                       t-att-value="post.get('city') or (family and family[0].city) or ''"/>
                                <input class="fzp-input mt-2" type="text" name="street"
                                       placeholder="Area or address (optional)"
                                       t-att-value="post.get('street') or ''"/>
                            </div>

                            <div class="fzp-field">
                                <label class="fzp-label" for="fzp-when">Preferred day (optional)</label>
                                <p t-if="errors.get('scheduled_date')" class="fzp-error"
                                   t-out="errors['scheduled_date']"/>
                                <input id="fzp-when" class="fzp-input" type="date" name="scheduled_date"
                                       t-att-value="post.get('scheduled_date') or ''"/>
                                <p class="fzp-meta mt-1 mb-0">We will confirm before anyone sets out.</p>
                            </div>

                            <div class="fzp-field">
                                <label class="fzp-label" for="fzp-notes">Care notes</label>
                                <textarea id="fzp-notes" class="fzp-input" name="description" rows="4"
                                          placeholder="Buy the same BP medicine as last time. Please call before delivering."
                                          t-out="post.get('description') or ''"></textarea>
                            </div>

                            <label class="fzp-check">
                                <input type="checkbox" name="urgent" value="1"
                                       t-att-checked="post.get('urgent') or None"/>
                                <span>This is urgent</span>
                            </label>

                            <!-- The real faizy.order.privacy_mode, described the way it
                                 actually behaves. It withholds the member's identity from
                                 the assigned Faizy; it does not hide what anything cost. -->
                            <label class="fzp-check">
                                <input type="checkbox" name="privacy_mode" value="1"
                                       t-att-checked="post.get('privacy_mode') or None"/>
                                <span>
                                    Keep this private
                                    <span class="fzp-check-note">
                                        The Faizy sees the task and the address, but not their
                                        name, phone or these notes.
                                    </span>
                                </span>
                            </label>
                        </div>

                        <div class="fzp-submit">
                            <button type="submit" class="fzp-btn">Send request</button>
                            <a t-if="wa_new_task" class="fzp-link" t-att-href="wa_new_task"
                               target="_blank" rel="noopener">or message us on WhatsApp →</a>
                        </div>
                    </form>

                  </div>
                </div>

                <t t-call="faizy_website.portal_tabbar"/>
            </div>
        </t>
    </template>

    <template id="portal_order_detail" name="Faizy — Order Detail">
        <t t-call="website.layout">
            <t t-set="additional_title">Care order</t>
            <div id="wrap" class="faizy-page">
                <t t-call="portal.portal_back_in_edit_mode"/>

                <div class="fzp">
                  <div class="fzp-inner">

                    <div t-if="just_created" class="fzp-alert is-good">
                        <strong>Request received.</strong>
                        We have it — <t t-out="order.name"/>. Someone will pick it up and
                        you will see the status change here.
                    </div>

                    <div class="fzp-head">
                        <div>
                            <p class="fzp-eyebrow" t-out="order.name"/>
                            <h1 class="fzp-title" t-out="order.title"/>
                        </div>
                        <span t-attf-class="faizy-status is-#{order.state}"
                              t-out="dict(order._fields['state'].selection).get(order.state)"/>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-7">
                            <div class="fzp-card">
                                <h2 class="fzp-meta mb-3">Details</h2>
                                <dl class="row mb-0">
                                    <dt class="col-5 col-sm-4 fw-normal fzp-meta">Service</dt>
                                    <dd class="col-7 col-sm-8" t-out="order.service_id.name"/>

                                    <dt class="col-5 col-sm-4 fw-normal fzp-meta">For</dt>
                                    <dd class="col-7 col-sm-8">
                                        <span t-if="order.family_member_id">
                                            <span t-out="order.family_member_id.name"/>
                                            <span class="faizy-fmb ms-1"
                                                  t-out="order.family_member_id.fmb_id"/>
                                        </span>
                                        <span t-else="" class="fzp-meta">The household</span>
                                    </dd>

                                    <dt class="col-5 col-sm-4 fw-normal fzp-meta">Where</dt>
                                    <dd class="col-7 col-sm-8" t-out="order.city"/>

                                    <dt class="col-5 col-sm-4 fw-normal fzp-meta">Your Faizy</dt>
                                    <dd class="col-7 col-sm-8">
                                        <span t-if="worker_name" t-out="worker_name"/>
                                        <span t-else="" class="fzp-meta">Being assigned</span>
                                    </dd>
                                </dl>
                                <div t-if="order.description" class="mt-3">
                                    <h2 class="fzp-meta mb-1">Notes</h2>
                                    <p class="mb-0" t-out="order.description"/>
                                </div>
                            </div>

                            <div t-if="order.proof_image" class="fzp-card">
                                <h2 class="fzp-meta mb-3">Proof of delivery</h2>
                                <img t-attf-src="/web/image/faizy.order/#{order.id}/proof_image"
                                     class="img-fluid rounded" alt="Proof of delivery"/>
                                <p t-if="order.completion_note" class="fzp-meta mt-2 mb-0"
                                   t-out="order.completion_note"/>
                            </div>

                            <!-- The paper behind what they were charged. Shown
                                 whenever it exists, not only once completed —
                                 a customer who has been billed for purchases
                                 should not have to wait to see why. -->
                            <div t-if="order.receipt_image" class="fzp-card">
                                <h2 class="fzp-meta mb-3">Receipt</h2>
                                <img t-attf-src="/web/image/faizy.order/#{order.id}/receipt_image"
                                     class="img-fluid rounded" alt="Receipt"/>
                                <p t-if="order.receipt_note" class="fzp-meta mt-2 mb-0"
                                   t-out="order.receipt_note"/>
                            </div>
                        </div>

                        <div class="col-12 col-lg-5">
                            <div class="fzp-card">
                                <h2 class="fzp-meta mb-3">Charges</h2>
                                <dl class="row mb-0">
                                    <dt class="col-7 fw-normal fzp-meta">Purchases</dt>
                                    <dd class="col-5 text-end" t-out="order.purchase_value"
                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>

                                    <dt class="col-7 fw-normal fzp-meta">Service fee</dt>
                                    <dd class="col-5 text-end" t-out="order.service_fee"
                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>

                                    <dt class="col-7 fw-normal fzp-meta">Platform fee</dt>
                                    <dd class="col-5 text-end" t-out="order.platform_fee"
                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>

                                    <dt class="col-7 fw-bold border-top pt-2">Total</dt>
                                    <dd class="col-5 text-end fw-bold border-top pt-2"
                                        t-out="order.amount_total"
                                        t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <a href="/care/orders" class="fzp-link d-inline-block mt-4">← Back to orders</a>

                  </div>
                </div>

                <t t-call="faizy_website.portal_tabbar"/>
            </div>
        </t>
    </template>

</odoo>
