<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brand fonts. Poppins for everything Latin; Noto Nastaliq Urdu loaded
         only because the tagline needs it — Nastaliq will not render correctly
         from a generic serif fallback. -->
    <template id="faizy_fonts" inherit_id="website.layout" name="Faizy Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&amp;family=Noto+Nastaliq+Urdu:wght@400;600&amp;display=swap"/>
        </xpath>
    </template>

    <!-- ── Home ───────────────────────────────────────────────────────── -->
    <template id="home" name="Faizy — Home">
        <t t-call="website.layout">
            <div id="wrap" class="faizy-page">

                <section class="faizy-hero">
                    <div class="container text-center">
                        <p class="faizy-hero-tagline faizy-urdu mb-2" lang="ur" dir="rtl">حاضر ہیں۔</p>
                        <h1 class="mb-3">Your family back home,<br/>looked after.</h1>
                        <p class="lead mb-4 mx-auto" style="max-width: 40rem; opacity: .85;">
                            Groceries, medicine, doctor visits, paperwork — run by vetted Faizies
                            on the ground in Pakistan. Booked on WhatsApp, confirmed in writing,
                            with a photo every time.
                        </p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <a href="/pricing" class="btn btn-faizy">See plans</a>
                            <a href="/join" class="btn btn-faizy-outline"
                               style="border-color: rgba(253,251,247,.3); color: #FDFBF7;">
                                Become a Faizy
                            </a>
                        </div>
                    </div>
                </section>

                <section class="container py-5">
                    <div class="text-center mb-5">
                        <h2>What we do</h2>
                        <p class="text-muted">Every task confirmed, receipted and photographed.</p>
                    </div>
                    <div class="row g-3">
                        <t t-foreach="services" t-as="service">
                            <div class="col-12 col-sm-6 col-lg-4">
                                <div class="faizy-card">
                                    <div style="font-size: 1.75rem;" t-out="service.icon"/>
                                    <h3 class="h5 mt-2 mb-1" t-out="service.name"/>
                                    <p class="text-muted mb-0 small" t-out="service.description"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>

                <section class="py-5" style="background: #FAF6EF;">
                    <div class="container">
                        <div class="text-center mb-5">
                            <h2>How it works</h2>
                        </div>
                        <div class="row g-4 text-center">
                            <div class="col-12 col-md-4">
                                <div class="faizy-card">
                                    <h3 class="h6 text-uppercase text-muted mb-2">Step one</h3>
                                    <h4 class="h5">Tell us who to care for</h4>
                                    <p class="text-muted small mb-0">
                                        Add each family member. They get their own FMB ID, so every
                                        request is unambiguous.
                                    </p>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="faizy-card">
                                    <h3 class="h6 text-uppercase text-muted mb-2">Step two</h3>
                                    <h4 class="h5">Ask on WhatsApp</h4>
                                    <p class="text-muted small mb-0">
                                        Send what you need. We confirm it in writing and assign a
                                        vetted Faizy nearby.
                                    </p>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="faizy-card">
                                    <h3 class="h6 text-uppercase text-muted mb-2">Step three</h3>
                                    <h4 class="h5">See it done</h4>
                                    <p class="text-muted small mb-0">
                                        Photo proof and a receipt on completion. No wondering
                                        whether it happened.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="container py-5">
                    <div class="text-center mb-4">
                        <h2>Plans</h2>
                        <p class="text-muted">Your first three care activities are on us.</p>
                    </div>
                    <t t-call="faizy_website.plan_cards"/>
                </section>

            </div>
        </t>
    </template>

    <!-- Shared so home and /pricing cannot drift apart. -->
    <template id="plan_cards" name="Faizy Plan Cards">
        <div class="row g-3 justify-content-center">
            <t t-foreach="plans" t-as="plan">
                <div class="col-12 col-md-6 col-lg-4">
                    <div t-attf-class="faizy-plan-card #{plan.code == 'standard' and 'is-featured' or ''}">
                        <span t-if="plan.code == 'standard'"
                              class="badge text-bg-warning align-self-start mb-2">Most chosen</span>
                        <h3 class="h4 mb-1" t-out="plan.name"/>
                        <p class="text-muted small" t-out="plan.description"/>
                        <div class="faizy-plan-price my-3">
                            <span t-out="plan.currency_id.symbol or plan.currency_id.name"/><!--
                            --><span t-out="'%.2f' % plan.price"/>
                            <span class="fs-6 fw-normal text-muted">/month</span>
                        </div>
                        <ul class="list-unstyled mb-4 small">
                            <t t-foreach="plan.feature_ids" t-as="feature">
                                <li class="mb-1">
                                    <i class="fa fa-check me-2" style="color:#F69E22"/>
                                    <span t-out="feature.name"/>
                                </li>
                            </t>
                        </ul>
                        <div class="mt-auto">
                            <a href="/contactus" class="btn btn-faizy w-100">Get started</a>
                            <p class="text-muted small text-center mt-2 mb-0">
                                Extra activities
                                <span t-out="plan.currency_id.symbol or plan.currency_id.name"/><!--
                                --><span t-out="'%.2f' % plan.overage_price"/> each
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <template id="pricing" name="Faizy — Pricing">
        <t t-call="website.layout">
            <div id="wrap" class="faizy-page">
                <div class="container py-5">
                    <div class="text-center mb-5">
                        <h1>Simple plans</h1>
                        <p class="text-muted">
                            Pay monthly. Your first three care activities are free.
                        </p>
                    </div>
                    <t t-call="faizy_website.plan_cards"/>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Worker sign-up ─────────────────────────────────────────────── -->
    <template id="join" name="Faizy — Become a Faizy">
        <t t-call="website.layout">
            <div id="wrap" class="faizy-page">
                <div class="container py-5" style="max-width: 46rem;">
                    <h1 class="mb-1">Become a Faizy</h1>
                    <p class="text-muted mb-4">
                        Honest work, close to home, paid per task. Tell us about yourself and
                        we will be in touch.
                    </p>

                    <form action="/join/submit" method="POST" class="faizy-card">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <!-- Honeypot: hidden from people, irresistible to naive bots. -->
                        <div style="position:absolute; left:-9999px;" aria-hidden="true">
                            <label for="website_hp">Leave this empty</label>
                            <input type="text" id="website_hp" name="website" tabindex="-1" autocomplete="off"/>
                        </div>

                        <h2 class="h5 mb-3">About you</h2>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="name">Full name *</label>
                                <input type="text" id="name" name="name" class="form-control"
                                       t-att-value="values.get('name', '')" required="required"/>
                                <div class="text-danger small" t-if="errors.get('name')" t-out="errors['name']"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="phone">Phone (WhatsApp) *</label>
                                <input type="tel" id="phone" name="phone" class="form-control"
                                       placeholder="+92 300 1234567"
                                       t-att-value="values.get('phone', '')" required="required"/>
                                <div class="text-danger small" t-if="errors.get('phone')" t-out="errors['phone']"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="cnic">CNIC *</label>
                                <input type="text" id="cnic" name="cnic" class="form-control"
                                       placeholder="00000-0000000-0" pattern="\d{5}-\d{7}-\d"
                                       t-att-value="values.get('cnic', '')" required="required"/>
                                <div class="text-danger small" t-if="errors.get('cnic')" t-out="errors['cnic']"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="email">Email</label>
                                <input type="email" id="email" name="email" class="form-control"
                                       t-att-value="values.get('email', '')"/>
                            </div>
                        </div>

                        <h2 class="h5 mt-4 mb-3">Where you work</h2>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="city">City *</label>
                                <input type="text" id="city" name="city" class="form-control"
                                       t-att-value="values.get('city', '')" required="required"/>
                                <div class="text-danger small" t-if="errors.get('city')" t-out="errors['city']"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="area_ids">Areas you cover</label>
                                <select id="area_ids" name="area_ids" class="form-select" multiple="multiple" size="4">
                                    <t t-foreach="areas" t-as="area">
                                        <option t-att-value="area.id" t-out="area.display_name"/>
                                    </t>
                                </select>
                            </div>
                        </div>

                        <h2 class="h5 mt-4 mb-3">What you can do</h2>
                        <div class="row g-2">
                            <t t-foreach="services" t-as="service">
                                <div class="col-12 col-sm-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="service_ids" t-att-value="service.id"
                                               t-attf-id="service_#{service.id}"/>
                                        <label class="form-check-label" t-attf-for="service_#{service.id}">
                                            <span t-out="service.icon"/> <span t-out="service.name"/>
                                        </label>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-12">
                                <label class="form-label" for="availability">When you are available</label>
                                <input type="text" id="availability" name="availability" class="form-control"
                                       placeholder="e.g. Mon–Sat, 9am–6pm"
                                       t-att-value="values.get('availability', '')"/>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="checkbox"
                                           id="has_vehicle" name="has_vehicle"/>
                                    <label class="form-check-label" for="has_vehicle">I have a vehicle</label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="vehicle_type">Vehicle type</label>
                                <input type="text" id="vehicle_type" name="vehicle_type" class="form-control"
                                       placeholder="Motorbike, car…"
                                       t-att-value="values.get('vehicle_type', '')"/>
                            </div>
                        </div>

                        <h2 class="h5 mt-4 mb-3">Experience</h2>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="experience_years">Years of experience</label>
                                <input type="number" id="experience_years" name="experience_years"
                                       class="form-control" min="0"
                                       t-att-value="values.get('experience_years', '')"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="experience_notes">Tell us briefly what you have done</label>
                                <textarea id="experience_notes" name="experience_notes"
                                          class="form-control" rows="3"
                                          t-out="values.get('experience_notes', '')"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="reference_contacts">Two references (name, relationship, phone)</label>
                                <textarea id="reference_contacts" name="reference_contacts"
                                          class="form-control" rows="2"
                                          t-out="values.get('reference_contacts', '')"/>
                            </div>
                        </div>

                        <h2 class="h5 mt-4 mb-3">Agreements</h2>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="code_of_conduct" name="code_of_conduct" required="required"/>
                            <label class="form-check-label" for="code_of_conduct">
                                I accept the Faizy code of conduct *
                            </label>
                            <div class="text-danger small" t-if="errors.get('code_of_conduct')"
                                 t-out="errors['code_of_conduct']"/>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="rate_card" name="rate_card" required="required"/>
                            <label class="form-check-label" for="rate_card">
                                I accept the rate card *
                            </label>
                            <div class="text-danger small" t-if="errors.get('rate_card')"
                                 t-out="errors['rate_card']"/>
                        </div>

                        <p class="text-muted small mt-3">
                            We will ask for your CNIC photos and a selfie after this first step.
                        </p>
                        <button type="submit" class="btn btn-faizy mt-2">Send application</button>
                    </form>

                    <p class="text-center text-muted small mt-3">
                        Already applied? <a href="/join/status">Check your status</a>.
                    </p>
                </div>
            </div>
        </t>
    </template>

    <template id="join_thanks" name="Faizy — Application Received">
        <t t-call="website.layout">
            <div id="wrap" class="faizy-page">
                <div class="container py-5 text-center" style="max-width: 34rem;">
                    <div style="font-size: 3rem;">✅</div>
                    <h1 class="mt-3">Application received</h1>
                    <p class="text-muted">
                        Thank you. Our team reviews every application and will contact you on
                        WhatsApp.
                    </p>
                    <div class="faizy-card mt-4" t-if="reference">
                        <p class="text-muted small mb-1">Your reference number</p>
                        <p class="h3 mb-0" t-out="reference"/>
                        <p class="text-muted small mt-2 mb-0">
                            Keep this — you will need it, with your phone number, to check
                            your status.
                        </p>
                    </div>
                    <a href="/join/status" class="btn btn-faizy-outline mt-4">Check status</a>
                </div>
            </div>
        </t>
    </template>

    <template id="join_status" name="Faizy — Application Status">
        <t t-call="website.layout">
            <div id="wrap" class="faizy-page">
                <div class="container py-5" style="max-width: 34rem;">
                    <h1 class="mb-3">Check your application</h1>
                    <form action="/join/status" method="GET" class="faizy-card mb-4">
                        <div class="mb-3">
                            <label class="form-label" for="reference">Reference number</label>
                            <input type="text" id="reference" name="reference" class="form-control"
                                   placeholder="FZY-10001" t-att-value="reference or ''" required="required"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="phone">Phone number</label>
                            <input type="tel" id="phone" name="phone" class="form-control"
                                   t-att-value="phone or ''" required="required"/>
                        </div>
                        <button type="submit" class="btn btn-faizy">Check</button>
                    </form>

                    <div t-if="searched and application" class="faizy-card">
                        <p class="text-muted small mb-1">Status</p>
                        <p class="h4" t-out="dict(application._fields['state'].selection).get(application.state)"/>
                        <p class="text-muted small mb-0">
                            Submitted <span t-out="application.create_date" t-options="{'widget': 'date'}"/>
                        </p>
                    </div>
                    <div t-if="searched and not application" class="alert alert-warning">
                        We could not find an application with that reference and phone number.
                        Please check both and try again.
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
