<?xml version="1.0" encoding="utf-8"?>
<!-- Website navigation. noupdate so marketing can rename or reorder these in
     the website editor without a module upgrade putting them back. -->
<odoo noupdate="1">

    <record id="menu_faizy_pricing" model="website.menu">
        <field name="name">Plans</field>
        <field name="url">/pricing</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">20</field>
    </record>

    <record id="menu_faizy_join" model="website.menu">
        <field name="name">Become a Faizy</field>
        <field name="url">/join</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">30</field>
    </record>

    <!-- The product IS WhatsApp, so the header carries the same door the
         service runs through. `/whatsapp` rather than a wa.me link typed in
         here: the number lives on res.company and a copy of it in a data
         record becomes a second number the day the first one changes. -->
    <record id="menu_faizy_whatsapp" model="website.menu">
        <field name="name">WhatsApp</field>
        <field name="url">/whatsapp</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">35</field>
    </record>

    <!-- Last, so it reads as the end of the journey rather than another
         browsing option. -->
    <record id="menu_faizy_start" model="website.menu">
        <field name="name">Start free</field>
        <field name="url">/start</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">40</field>
    </record>

</odoo>
