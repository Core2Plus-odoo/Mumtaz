<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_faizy" model="ir.module.category">
        <field name="name">Faizy</field>
        <field name="description">Family care operations</field>
        <field name="sequence">20</field>
    </record>

    <!-- ── Agent ────────────────────────────────────────────────────────
         Day-to-day ops: take bookings, assign Faizies, move orders along.
         Cannot see medical notes or touch money settings.               -->
    <record id="group_faizy_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="module_category_faizy"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ── Operations ───────────────────────────────────────────────────
         Adds the sensitive layer: medical notes, the applications pipeline,
         wallet adjustments.                                              -->
    <record id="group_faizy_ops" model="res.groups">
        <field name="name">Operations</field>
        <field name="category_id" ref="module_category_faizy"/>
        <field name="implied_ids" eval="[(4, ref('group_faizy_user'))]"/>
    </record>

    <!-- ── Manager ──────────────────────────────────────────────────────
         Plans, pricing, subscriptions, the WhatsApp queue.               -->
    <record id="group_faizy_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_faizy"/>
        <field name="implied_ids" eval="[(4, ref('group_faizy_ops'))]"/>
    </record>

    <!-- ── Record rules ─────────────────────────────────────────────────
         A portal customer must only ever see their own records. Without
         these, the customer portal would expose every family in the system. -->

    <record id="rule_order_portal" model="ir.rule">
        <field name="name">Faizy Order: customers see only their own</field>
        <field name="model_id" ref="model_faizy_order"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_family_member_portal" model="ir.rule">
        <field name="name">Faizy Family Member: customers see only their own</field>
        <field name="model_id" ref="model_faizy_family_member"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_subscription_portal" model="ir.rule">
        <field name="name">Faizy Subscription: customers see only their own</field>
        <field name="model_id" ref="model_faizy_subscription"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A Faizy in the portal sees the jobs assigned to them, nothing else. -->
    <record id="rule_order_worker_portal" model="ir.rule">
        <field name="name">Faizy Order: workers see their own assignments</field>
        <field name="model_id" ref="model_faizy_order"/>
        <field name="domain_force">[('worker_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Internal staff see everything for their own company. -->
    <record id="rule_order_company" model="ir.rule">
        <field name="name">Faizy Order: company scope</field>
        <field name="model_id" ref="model_faizy_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
