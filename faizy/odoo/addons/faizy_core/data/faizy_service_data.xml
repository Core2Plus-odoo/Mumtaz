<?xml version="1.0" encoding="UTF-8"?>
<!-- The real catalogue, taken from the customer app prototype:
     five categories, twenty services, PKR service charges and the unit
     each charge covers. Purchases are always on top of these.

     noupdate so ops can retire or reprice a service without a module
     upgrade putting it back. -->
<odoo noupdate="1">

    <record id="cat_daily" model="faizy.service.category">
        <field name="name">Daily Life</field>
        <field name="code">daily</field>
        <field name="icon">💊</field>
        <field name="color">#FFF4DC</field>
        <field name="tagline">recurring needs, sorted</field>
        <field name="sequence">10</field>
    </record>

    <record id="service_med" model="faizy.service">
        <field name="name">Medicines &amp; Pharmacy</field>
        <field name="code">med</field>
        <field name="category_id" ref="cat_daily"/>
        <field name="icon">💊</field>
        <field name="price_pkr">850</field>
        <field name="price_unit">+ medicines</field>
        <field name="description">Servaid, Chughtai, D Watson. Monthly auto-refill.</field>
        <field name="sequence">11</field>
    </record>

    <record id="service_bills" model="faizy.service">
        <field name="name">Bills &amp; Utilities</field>
        <field name="code">bills</field>
        <field name="category_id" ref="cat_daily"/>
        <field name="icon">⚡</field>
        <field name="price_pkr">500</field>
        <field name="price_unit">per bill</field>
        <field name="description">K-Electric, SSGC, internet, mobile.</field>
        <field name="sequence">12</field>
    </record>

    <record id="service_groc" model="faizy.service">
        <field name="name">Grocery &amp; Daily</field>
        <field name="code">groc</field>
        <field name="category_id" ref="cat_daily"/>
        <field name="icon">🛒</field>
        <field name="price_pkr">1200</field>
        <field name="price_unit">+ groceries</field>
        <field name="description">Imtiaz, Naheed, Carrefour. Weekly basket.</field>
        <field name="sequence">13</field>
    </record>

    <record id="service_maid" model="faizy.service">
        <field name="name">Maid &amp; Cleaning</field>
        <field name="code">maid</field>
        <field name="category_id" ref="cat_daily"/>
        <field name="icon">🧹</field>
        <field name="price_pkr">8500</field>
        <field name="price_unit">/month</field>
        <field name="description">Trusted household help.</field>
        <field name="sequence">14</field>
    </record>

    <record id="cat_family" model="faizy.service.category">
        <field name="name">Family Care</field>
        <field name="code">family</field>
        <field name="icon">👵</field>
        <field name="color">#FDE8DF</field>
        <field name="tagline">because someone has to be there</field>
        <field name="sequence">20</field>
    </record>

    <record id="service_elder" model="faizy.service">
        <field name="name">Eldercare Visits</field>
        <field name="code">elder</field>
        <field name="category_id" ref="cat_family"/>
        <field name="icon">👵</field>
        <field name="price_pkr">1800</field>
        <field name="price_unit">per visit</field>
        <field name="description">Weekly check-ins for parents.</field>
        <field name="sequence">21</field>
    </record>

    <record id="service_hosp" model="faizy.service">
        <field name="name">Hospital Escort</field>
        <field name="code">hosp</field>
        <field name="category_id" ref="cat_family"/>
        <field name="icon">🏥</field>
        <field name="price_pkr">2800</field>
        <field name="price_unit">per visit</field>
        <field name="description">Doctor appointments and lab tests.</field>
        <field name="sequence">22</field>
    </record>

    <record id="service_school" model="faizy.service">
        <field name="name">School Matters</field>
        <field name="code">school</field>
        <field name="category_id" ref="cat_family"/>
        <field name="icon">🎓</field>
        <field name="price_pkr">1200</field>
        <field name="price_unit">per task</field>
        <field name="description">Fees, PTM, result collection.</field>
        <field name="sequence">23</field>
    </record>

    <record id="service_comp" model="faizy.service">
        <field name="name">Companionship</field>
        <field name="code">comp</field>
        <field name="category_id" ref="cat_family"/>
        <field name="icon">💙</field>
        <field name="price_pkr">2000</field>
        <field name="price_unit">per visit</field>
        <field name="description">Tea, walks, conversation for elders.</field>
        <field name="sequence">24</field>
    </record>

    <record id="cat_docs" model="faizy.service.category">
        <field name="name">Documents</field>
        <field name="code">docs</field>
        <field name="icon">📄</field>
        <field name="color">#DAE6FB</field>
        <field name="tagline">paperwork without the headache</field>
        <field name="sequence">30</field>
    </record>

    <record id="service_nad" model="faizy.service">
        <field name="name">NADRA Renewal</field>
        <field name="code">nad</field>
        <field name="category_id" ref="cat_docs"/>
        <field name="icon">🪪</field>
        <field name="price_pkr">1500</field>
        <field name="price_unit">+ govt fee</field>
        <field name="description">CNIC, B-form, corrections.</field>
        <field name="sequence">31</field>
    </record>

    <record id="service_pass" model="faizy.service">
        <field name="name">Passport Services</field>
        <field name="code">pass</field>
        <field name="category_id" ref="cat_docs"/>
        <field name="icon">🛂</field>
        <field name="price_pkr">2800</field>
        <field name="price_unit">+ govt fee</field>
        <field name="description">New, renewal, urgent.</field>
        <field name="sequence">32</field>
    </record>

    <record id="service_attest" model="faizy.service">
        <field name="name">Attestation</field>
        <field name="code">attest</field>
        <field name="category_id" ref="cat_docs"/>
        <field name="icon">📜</field>
        <field name="price_pkr">3800</field>
        <field name="price_unit">+ fee</field>
        <field name="description">HEC, MOFA, embassy attestation.</field>
        <field name="sequence">33</field>
    </record>

    <record id="service_fbr" model="faizy.service">
        <field name="name">FBR &amp; Tax Filing</field>
        <field name="code">fbr</field>
        <field name="category_id" ref="cat_docs"/>
        <field name="icon">💼</field>
        <field name="price_pkr">5500</field>
        <field name="price_unit">per year</field>
        <field name="description">Annual tax return filing.</field>
        <field name="sequence">34</field>
    </record>

    <record id="cat_occasions" model="faizy.service.category">
        <field name="name">Occasions</field>
        <field name="code">occasions</field>
        <field name="icon">🎁</field>
        <field name="color">#FCD7F0</field>
        <field name="tagline">be there — even when you can't</field>
