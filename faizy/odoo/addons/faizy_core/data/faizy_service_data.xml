        <field name="sequence">54</field>
    </record>

    <record id="cat_other" model="faizy.service.category">
        <field name="name">Other</field>
        <field name="code">other</field>
        <field name="icon">📦</field>
        <field name="sequence">60</field>
    </record>

    <record id="service_emergency" model="faizy.service">
        <field name="name">Emergency Response</field>
        <field name="code">emergency</field>
        <field name="category_id" ref="cat_other"/>
        <field name="icon">🚨</field>
        <field name="consumes_activity" eval="False"/>
        <field name="description">Urgent help when something goes wrong. Never counted against your monthly activities.</field>
        <field name="sequence">61</field>
    </record>

    <record id="service_product_request" model="faizy.service">
        <field name="name">Product Finder</field>
        <field name="code">product_request</field>
        <field name="category_id" ref="cat_other"/>
        <field name="icon">🔎</field>
        <field name="description">Describe any product. We source, quote and deliver, plus the 5% platform fee.</field>
        <field name="sequence">62</field>
    </record>

</odoo>
