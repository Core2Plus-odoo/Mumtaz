    <record id="service_gift" model="faizy.service">
        <field name="name">Gifts to Relatives</field>
        <field name="code">gift</field>
        <field name="category_id" ref="cat_occasions"/>
        <field name="icon">🎁</field>
        <field name="price_pkr">1800</field>
        <field name="price_unit">+ gift</field>
        <field name="description">Birthdays, anniversaries, new baby.</field>
        <field name="sequence">44</field>
    </record>

    <record id="cat_property" model="faizy.service.category">
        <field name="name">Property &amp; Errands</field>
        <field name="code">property</field>
        <field name="icon">🏠</field>
        <field name="color">#D6F2E0</field>
        <field name="tagline">things that need someone on ground</field>
        <field name="sequence">50</field>
    </record>

    <record id="service_prop" model="faizy.service">
        <field name="name">Property Visits</field>
