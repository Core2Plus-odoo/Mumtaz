<?xml version="1.0" encoding="UTF-8"?>
<!--
  Subscription tiers — the REAL numbers, taken from the customer app prototype.
  These replace the placeholders that were in here before:

    Lite        10 activities/mo, PKR 300 per extra, up to 2 family members
    Standard    30 activities/mo, PKR 250 per extra, up to 5 family members
    Family Pro  60 activities/mo, PKR 200 per extra, up to 10 family members

  Prices are the same in every currency the app quotes: PKR 1999 / 4999 / 8999,
  AED 26.50 / 66.20 / 119.20. Overage is priced in PKR because that is where the
  work is done.

  noupdate so ops edits survive module upgrades.
-->
<odoo noupdate="1">

    <record id="plan_lite" model="faizy.plan">
        <field name="name">Lite</field>
        <field name="code">lite</field>
        <field name="sequence">10</field>
        <field name="price">26.50</field>
        <field name="activities_included">10</field>
        <field name="overage_price_pkr">300</field>
        <field name="max_family_members">2</field>
        <field name="description">Essential support for one or two people back home.</field>
    </record>

    <record id="plan_lite_f1" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_lite"/>
        <field name="sequence">10</field>
        <field name="name">10 activities a month</field>
    </record>
    <record id="plan_lite_f2" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_lite"/>
        <field name="sequence">20</field>
        <field name="name">Up to 2 family members</field>
    </record>
    <record id="plan_lite_f3" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_lite"/>
        <field name="sequence">30</field>
        <field name="name">WhatsApp booking and updates</field>
    </record>
    <record id="plan_lite_f4" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_lite"/>
        <field name="sequence">40</field>
        <field name="name">Photo proof on every task</field>
    </record>

    <record id="plan_standard" model="faizy.plan">
        <field name="name">Standard</field>
        <field name="code">standard</field>
        <field name="sequence">20</field>
        <field name="price">66.20</field>
        <field name="activities_included">30</field>
        <field name="overage_price_pkr">250</field>
        <field name="max_family_members">5</field>
        <field name="description">Everything your family needs — every month.</field>
    </record>

    <record id="plan_standard_f1" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_standard"/>
        <field name="sequence">10</field>
        <field name="name">30 activities a month</field>
    </record>
    <record id="plan_standard_f2" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_standard"/>
        <field name="sequence">20</field>
        <field name="name">Up to 5 family members</field>
    </record>
    <record id="plan_standard_f3" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_standard"/>
        <field name="sequence">30</field>
        <field name="name">Priority assignment</field>
    </record>
    <record id="plan_standard_f4" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_standard"/>
        <field name="sequence">40</field>
        <field name="name">Monthly spending report</field>
    </record>

    <record id="plan_family_pro" model="faizy.plan">
        <field name="name">Family Pro</field>
        <field name="code">family_pro</field>
        <field name="sequence">30</field>
        <field name="price">119.20</field>
        <field name="activities_included">60</field>
        <field name="overage_price_pkr">200</field>
        <field name="max_family_members">10</field>
        <field name="description">Peace of mind for large families.</field>
    </record>

    <record id="plan_family_pro_f1" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_family_pro"/>
        <field name="sequence">10</field>
        <field name="name">60 activities a month</field>
    </record>
    <record id="plan_family_pro_f2" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_family_pro"/>
        <field name="sequence">20</field>
        <field name="name">Up to 10 family members</field>
    </record>
    <record id="plan_family_pro_f3" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_family_pro"/>
        <field name="sequence">30</field>
        <field name="name">Priority and emergency response</field>
    </record>
    <record id="plan_family_pro_f4" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_family_pro"/>
        <field name="sequence">40</field>
        <field name="name">Product sourcing requests</field>
    </record>
    <record id="plan_family_pro_f5" model="faizy.plan.feature">
        <field name="plan_id" ref="plan_family_pro"/>
        <field name="sequence">50</field>
        <field name="name">Full spending analytics</field>
    </record>

</odoo>
