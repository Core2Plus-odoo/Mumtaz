<?xml version="1.0" encoding="utf-8"?>
<!-- The landing screen for the Faizy app.

     Laid out as four bands that match how the day actually runs: what needs
     doing now, what the customer base looks like, what it earned, and whether
     the network is healthy. "Needs attention" comes first on purpose — a
     dashboard whose top row is a vanity metric gets read once and then
     ignored.

     Every tile is a button. A number you cannot click into is a number you
     cannot check, and an unverifiable dashboard stops being trusted the first
     time it looks wrong. -->
<odoo>

    <record id="view_faizy_dashboard_form" model="ir.ui.view">
        <field name="name">faizy.dashboard.form</field>
        <field name="model">faizy.dashboard</field>
        <field name="arch" type="xml">
            <form string="Faizy" create="false" edit="false">
                <field name="currency_id" invisible="1"/>
                <sheet>
                    <div class="oe_title mb-4">
                        <h1 class="mb-0">Faizy</h1>
                        <p class="text-muted mb-0">How the business looks right now.</p>
                    </div>

                    <group string="Needs attention">
                        <group>
                            <field name="orders_unassigned"
                                   string="Waiting for a Faizy"/>
                            <field name="applications_pending"
                                   string="Applications to review"/>
                        </group>
                        <group>
                            <field name="documents_expiring"
                                   string="Documents expiring or expired"/>
                            <field name="whatsapp_queued"
                                   string="WhatsApp messages queued"/>
                        </group>
                    </group>
                    <div class="mb-4">
                        <button name="action_open_unassigned" type="object"
                                class="btn btn-primary me-2" string="Unassigned orders"/>
                        <button name="action_open_applications" type="object"
                                class="btn btn-secondary me-2" string="Applications"/>
                        <button name="action_open_documents" type="object"
                                class="btn btn-secondary me-2" string="Documents"/>
                        <button name="action_open_whatsapp" type="object"
                                class="btn btn-secondary" string="WhatsApp queue"/>
                    </div>

                    <group string="Customers">
                        <group>
                            <field name="active_subscriptions"/>
                            <field name="customers"/>
                        </group>
                        <group>
                            <field name="mrr"/>
                            <field name="families"/>
                        </group>
                    </group>
                    <div class="mb-4">
                        <button name="action_open_subscriptions" type="object"
                                class="btn btn-secondary me-2" string="Subscriptions"/>
                        <button name="action_open_customers" type="object"
                                class="btn btn-secondary" string="Customers"/>
                    </div>

                    <group string="This month">
                        <group>
                            <field name="orders_month"/>
                            <field name="orders_completed_month" string="Completed"/>
                        </group>
                        <group>
                            <!-- What Faizy keeps. Purchases passed through to
                                 the customer are not revenue, and counting them
                                 would inflate this by an order of magnitude. -->
                            <field name="revenue_month" string="Revenue (fees kept)"/>
                            <field name="commission_month" string="Vendor commission"/>
                        </group>
                    </group>
                    <div class="mb-4">
                        <button name="action_open_orders" type="object"
                                class="btn btn-secondary me-2" string="Open orders"/>
                        <!-- Service split, city split and orders by month are
                             one group-by away in the graph and pivot views, and
                             they stay correct as the schema moves. -->
                        <button name="action_orders_analysis" type="object"
                                class="btn btn-secondary" string="Order analysis"/>
                    </div>

                    <group string="The ground network">
                        <group>
                            <field name="workers_active" string="Active Faizies"/>
                        </group>
                    </group>
                    <div>
                        <button name="action_open_workers" type="object"
                                class="btn btn-secondary" string="Faizies"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_faizy_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">faizy.dashboard</field>
        <field name="view_mode">form</field>
    </record>

</odoo>
