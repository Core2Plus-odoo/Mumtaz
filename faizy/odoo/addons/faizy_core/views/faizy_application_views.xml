<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_faizy_application_kanban" model="ir.ui.view">
        <field name="name">faizy.application.kanban</field>
        <field name="model">faizy.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted small mb-2"><field name="reference"/></div>
                            <div><i class="fa fa-map-marker me-1" title="City" aria-label="City" role="img"/><field name="city"/></div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-phone me-1" title="Phone" aria-label="Phone" role="img"/><field name="phone"/>
                            </div>
                            <div class="mt-2">
                                <field name="service_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_faizy_application_list" model="ir.ui.view">
        <field name="name">faizy.application.list</field>
        <field name="model">faizy.application</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state == 'rejected'">
                <field name="reference"/>
                <field name="create_date" string="Submitted" widget="date"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="experience_years" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <record id="view_faizy_application_form" model="ir.ui.view">
        <field name="name">faizy.application.form</field>
        <field name="model">faizy.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object" string="Start Review"
                            invisible="state != 'submitted'"/>
                    <button name="action_interview" type="object" string="Invite to Interview"
                            invisible="state not in ('submitted', 'under_review')"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state in ('approved', 'rejected')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('approved', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,under_review,interview,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_worker" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="not worker_id" string="Faizy Record"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3 class="text-muted"><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Applicant">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="cnic"/>
                            <field name="date_of_birth"/>
                        </group>
                        <group string="Coverage">
                            <field name="city"/>
                            <field name="area_ids" widget="many2many_tags"/>
                            <field name="has_vehicle"/>
                            <field name="vehicle_type" invisible="not has_vehicle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services &amp; Availability" name="services">
                            <group>
                                <field name="service_ids" widget="many2many_tags"/>
                                <field name="availability"/>
                            </group>
                        </page>
                        <page string="Experience" name="experience">
                            <group>
                                <field name="experience_years"/>
                                <field name="experience_notes"/>
                                <field name="reference_contacts"/>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <group col="3">
                                <field name="cnic_front" widget="image" options="{'size': [200, 200]}"/>
                                <field name="cnic_back" widget="image" options="{'size': [200, 200]}"/>
                                <field name="selfie" widget="image" options="{'size': [200, 200]}"/>
                            </group>
                        </page>
                        <page string="Agreements" name="agreements">
                            <group>
                                <field name="code_of_conduct_accepted"/>
                                <field name="rate_card_accepted"/>
                                <field name="date_accepted" readonly="1"/>
                            </group>
                        </page>
                        <page string="Review" name="review">
                            <group>
                                <field name="review_notes"/>
                                <field name="reviewer_id" readonly="1"/>
                                <field name="date_reviewed" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_faizy_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">faizy.application</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No applications yet.</p>
            <p>Applications from the public sign-up form land here for review.</p>
        </field>
    </record>
</odoo>
