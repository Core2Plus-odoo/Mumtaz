<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_faizy_worker_kanban" model="ir.ui.view">
        <field name="name">faizy.worker.kanban</field>
        <field name="model">faizy.worker</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="state"/>
                <field name="is_available"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <img t-att-src="kanban_image('faizy.worker', 'image_128', record.id.raw_value)"
                                     class="rounded-circle me-2 o_image_40_cover" alt="Faizy"/>
                                <div class="overflow-hidden">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted small"><field name="city"/></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span t-if="record.is_available.raw_value" class="badge text-bg-success">Available</span>
                                <span t-else="" class="badge text-bg-secondary">Off duty</span>
                                <span class="text-muted small">
                                    <field name="completed_count"/> done
                                </span>
                            </div>
                            <div class="mt-1 text-muted small" t-if="record.rating_count.raw_value">
                                <i class="fa fa-star text-warning me-1" title="Average rating" aria-label="Average rating" role="img"/><field name="rating_avg"/>
                                (<field name="rating_count"/>)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_faizy_worker_list" model="ir.ui.view">
        <field name="name">faizy.worker.list</field>
        <field name="model">faizy.worker</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'active'">
                <field name="reference"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="completed_count"/>
                <field name="cancelled_count" optional="hide"/>
                <field name="rating_avg" widget="float" digits="[3,2]"/>
                <field name="rating_count" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_faizy_worker_form" model="ir.ui.view">
        <field name="name">faizy.worker.form</field>
        <field name="model">faizy.worker</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_active" type="object" string="Activate"
                            class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="applicant,active"/>
                </header>
                <sheet>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <h3 class="text-muted"><field name="reference" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="cnic" groups="faizy_core.group_faizy_ops"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Work">
                            <field name="city"/>
                            <field name="is_available"/>
                            <field name="date_joined"/>
                            <field name="base_rate"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="area_ids" widget="many2many_tags"/>
                        <field name="service_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Performance" col="4">
                        <field name="completed_count" readonly="1"/>
                        <field name="cancelled_count" readonly="1"/>
                        <field name="rating_avg" readonly="1"/>
                        <field name="rating_count" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_faizy_worker_search" model="ir.ui.view">
        <field name="name">faizy.worker.search</field>
        <field name="model">faizy.worker</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="service_ids"/>
                <filter name="assignable" string="Available Now"
                        domain="[('state', '=', 'active'), ('is_available', '=', True)]"/>
                <filter name="active_workers" string="Active" domain="[('state', '=', 'active')]"/>
                <!-- Group-by filters sit directly in the search view. Odoo 19's
                     schema allows only <field> inside <group>, so the old
                     <group expand="0" string="Group By"> wrapper is invalid;
                     the client collects context group_by filters into the
                     Group By menu on its own. -->
                <separator/>
                <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_faizy_worker" model="ir.actions.act_window">
        <field name="name">Faizies</field>
        <field name="res_model">faizy.worker</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_faizy_worker_search"/>
    </record>

    <record id="view_faizy_area_list" model="ir.ui.view">
        <field name="name">faizy.area.list</field>
        <field name="model">faizy.area</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="city"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_faizy_area" model="ir.actions.act_window">
        <field name="name">Coverage Areas</field>
        <field name="res_model">faizy.area</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_faizy_service_list" model="ir.ui.view">
        <field name="name">faizy.service.list</field>
        <field name="model">faizy.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="code"/>
                <field name="consumes_activity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_faizy_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">faizy.service</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
