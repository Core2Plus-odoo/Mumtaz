<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vendors are res.partner records, so these are primary views on
         res.partner rather than a parallel model. Primary (no inherit_id)
         because the standard contact form is built for people and companies,
         and a pharmacy we buy medicines from needs coverage, services and a
         commission rate on the first screen, not behind three tabs. -->

    <record id="view_faizy_vendor_kanban" model="ir.ui.view">
        <field name="name">res.partner.kanban.faizy.vendor</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="faizy_vendor_state"/>
                <!-- Monetary fields render through the currency, so it has to
                     be fetched even though nothing displays it. -->
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center mb-2">
                                <img t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"
                                     class="rounded me-2 o_image_40_cover" alt="Vendor"/>
                                <div class="overflow-hidden">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted small">
                                        <field name="faizy_vendor_type"/>
                                        <t t-if="record.city.raw_value"> · <field name="city"/></t>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span t-if="record.faizy_vendor_state.raw_value == 'active'"
                                      class="badge text-bg-success">Active</span>
                                <span t-elif="record.faizy_vendor_state.raw_value == 'suspended'"
                                      class="badge text-bg-danger">Suspended</span>
                                <span t-else="" class="badge text-bg-secondary">Prospect</span>
                                <span class="text-muted small">
                                    <field name="faizy_vendor_order_count"/> orders
                                </span>
                            </div>
                            <div class="mt-1 text-muted small">
                                Commission earned <field name="faizy_vendor_commission_total"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_faizy_vendor_list" model="ir.ui.view">
        <field name="name">res.partner.list.faizy.vendor</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list decoration-muted="faizy_vendor_state != 'active'">
                <field name="faizy_vendor_code"/>
                <field name="name"/>
                <field name="faizy_vendor_type"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="faizy_vendor_order_count"/>
                <field name="faizy_vendor_purchase_value" optional="show"/>
                <field name="faizy_vendor_commission_total" optional="show"/>
                <field name="faizy_vendor_last_order" optional="hide"/>
                <field name="faizy_vendor_effective_rate" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="faizy_vendor_state" widget="badge"
                       decoration-success="faizy_vendor_state == 'active'"
                       decoration-danger="faizy_vendor_state == 'suspended'"/>
            </list>
        </field>
    </record>

    <record id="view_faizy_vendor_form" model="ir.ui.view">
        <field name="name">res.partner.form.faizy.vendor</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_faizy_vendor_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="faizy_vendor_state == 'active'"/>
                    <button name="action_faizy_vendor_suspend" type="object"
                            string="Suspend"
                            invisible="faizy_vendor_state != 'active'"/>
                    <field name="faizy_vendor_state" widget="statusbar"
                           statusbar_visible="prospect,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_faizy_vendor_orders" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="faizy_vendor_order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <!-- image_1920, not avatar_128: avatar_128 is computed and
                         read-only, so a form built on it looks editable and
                         silently discards the upload. Copied from Odoo's own
                         partner form. -->
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Al-Shifa Pharmacy"/></h1>
                        <h3 class="text-muted"><field name="faizy_vendor_code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Who they are">
                            <field name="faizy_vendor_type"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="vat"/>
                        </group>
                        <group string="Where they operate">
                            <field name="street" placeholder="Street"/>
                            <field name="city"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="faizy_vendor_onboarded"/>
                        </group>
                    </group>
                    <group>
                        <group string="Commission">
                            <!-- The company rate in Settings is the default. This
                                 is the exception, and it is explicit: 0% is a real
                                 arrangement, so "blank means inherit" would make it
                                 impossible to express. -->
                            <field name="faizy_vendor_custom_commission"/>
                            <field name="faizy_vendor_commission_rate"
                                   invisible="not faizy_vendor_custom_commission"
                                   required="faizy_vendor_custom_commission"/>
                            <field name="faizy_vendor_effective_rate" readonly="1"/>
                        </group>
                        <group string="Performance">
                            <field name="faizy_vendor_purchase_value"/>
                            <field name="faizy_vendor_commission_total"/>
                            <field name="faizy_vendor_last_order"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Coverage" name="coverage">
                            <group>
                                <field name="faizy_vendor_area_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="faizy_vendor_service_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </group>
                            <field name="faizy_vendor_note" placeholder="Delivery windows, who to ask for…"/>
                        </page>
                        <page string="Orders" name="orders">
                            <field name="faizy_vendor_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="city"/>
                                    <field name="purchase_value"/>
                                    <field name="vendor_commission"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="is_faizy_vendor" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_faizy_vendor_search" model="ir.ui.view">
        <field name="name">res.partner.search.faizy.vendor</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Vendor"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('faizy_vendor_code', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="city"/>
                <field name="faizy_vendor_area_ids" string="Area"/>
                <field name="faizy_vendor_service_ids" string="Service"/>
                <filter name="filter_active" string="Active"
                        domain="[('faizy_vendor_state', '=', 'active')]"/>
                <filter name="filter_prospect" string="Prospects"
                        domain="[('faizy_vendor_state', '=', 'prospect')]"/>
                <filter name="filter_suspended" string="Suspended"
                        domain="[('faizy_vendor_state', '=', 'suspended')]"/>
                <separator/>
                <filter name="filter_custom_commission" string="Negotiated Rate"
                        domain="[('faizy_vendor_custom_commission', '=', True)]"/>
                <!-- Group-by filters sit directly in the search view. Odoo 19's
                     schema allows only <field> inside <group>, so the old
                     <group expand="0" string="Group By"> wrapper is invalid;
                     the client collects context group_by filters into the
                     Group By menu on its own. -->
                <separator/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'faizy_vendor_type'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'faizy_vendor_state'}"/>
                <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
            </search>
        </field>
    </record>

    <record id="action_faizy_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_faizy_vendor', '=', True)]</field>
        <!-- default_is_faizy_vendor so a vendor created from this screen is one.
             default_supplier_rank so Odoo's own vendor bills offer them too —
             the create() override sets it as well, but a default keeps the form
             honest before it is saved. -->
        <field name="context">{'default_is_faizy_vendor': True, 'default_supplier_rank': 1}</field>
        <field name="search_view_id" ref="view_faizy_vendor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Add the first vendor</p>
            <p>
                Pharmacies, kiryana stores, labs and couriers that fulfil Faizy
                orders. Set a vendor on an order and the commission is retained
                automatically at the company rate — or at this vendor's own.
            </p>
        </field>
    </record>

    <!-- The same data on the standard contact form, so a vendor opened from
         Contacts is not a blank record with a mysterious code on it.

         `groups` is load-bearing here exactly as it is on the customer page:
         these fields reach faizy.area, faizy.service and faizy.order, and
         Contacts is used by people with no Faizy role at all. Without it,
         opening ANY contact raises an AccessError and the form will not render.
         `invisible=` does not help — it is evaluated client-side, so the field
         is still in the arch, still fetched, and the ACL still fires. -->
    <record id="view_partner_form_faizy_vendor" model="ir.ui.view">
        <field name="name">res.partner.form.faizy.vendor.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_faizy_vendor" groups="faizy_core.group_faizy_user"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Faizy Vendor" name="faizy_vendor"
                      groups="faizy_core.group_faizy_user"
                      invisible="not is_faizy_vendor">
                    <group>
                        <group string="Vendor">
                            <field name="faizy_vendor_code" readonly="1"/>
                            <field name="faizy_vendor_type"/>
                            <field name="faizy_vendor_state" widget="badge"/>
                            <field name="faizy_vendor_onboarded"/>
                        </group>
                        <group string="Commission">
                            <field name="faizy_vendor_custom_commission"/>
                            <field name="faizy_vendor_commission_rate"
                                   invisible="not faizy_vendor_custom_commission"
                                   required="faizy_vendor_custom_commission"/>
                            <field name="faizy_vendor_effective_rate" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="faizy_vendor_area_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="faizy_vendor_service_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <field name="faizy_vendor_note" placeholder="Delivery windows, who to ask for…"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
