# Mumtaz Jewel staging — copy to .env and fill in. NEVER commit .env.
#
# This file documents every knob. It contains no real value: the two passwords
# below are placeholders you must replace. Secrets come from the environment,
# never from code or from git (docs/mumtaz-jewel/CLAUDE.md).
#
# This .env belongs to the Jewel staging stack alone. Do not point it at the
# CRM database, and do not reuse delivery_api/.env or .env.staging here.

# --- Postgres (this stack's own cluster, not the CRM's) --------------------
POSTGRES_USER=jewel_staging
# Generate one, e.g.:  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_value

# --- Odoo master password (database manager screen) -----------------------
# Guards dropping and creating databases on the demo host. Generate as above.
ADMIN_PASSWORD=CHANGE_ME_generate_a_long_random_value

# --- Localhost ports nginx proxies to ------------------------------------
# 8069 is the Odoo default and 8070 is the existing staging stack, so Jewel
# uses 8072/8073. Change only if those are taken on the VPS.
JEWEL_HTTP_PORT=8072
JEWEL_POLL_PORT=8073

# --- The branch this host is allowed to serve ----------------------------
# deploy.sh refuses to run on any other branch, and refuses main outright.
JEWEL_BRANCH=claude/mumtaz-jewellery-phase2
