# Copy this to setup-lemp.env, fill in real values, then:
#   set -a; source ./setup-lemp.env; set +a; sudo -E bash setup-lemp.sh
#
# setup-lemp.env itself is gitignored — never commit it with real values.

ADMIN_EMAIL=you@example.com

# Generate strong unique values for these — do not reuse the examples below.
MYSQL_ROOT_PASS=change-me-mysql-root-password
DB1_PASS=change-me-odditytrend-db-password
DB2_PASS=change-me-youngcraze-db-password
