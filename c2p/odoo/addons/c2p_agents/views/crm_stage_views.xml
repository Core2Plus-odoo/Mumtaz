<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Surfaces the flag the proposal follow-up agent selects on. Without this
         the checkbox exists only in the database, which is halfway back to the
         problem this module solves. -->
    <record id="view_crm_stage_form_c2p_agents" model="ir.ui.view">
        <field name="name">crm.stage.form.c2p.agents</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_proposal_stage"/>
            </field>
        </field>
    </record>

</odoo>
