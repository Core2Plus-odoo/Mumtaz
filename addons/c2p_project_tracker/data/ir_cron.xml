<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Safety net for changes the write hooks missed. Odoo 19 ir.cron has
             no numbercall or doall fields. -->
        <record id="cron_c2p_sync" model="ir.cron">
            <field name="name">C2P Tracker: sync portfolio milestones</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="state">code</field>
            <field name="code">model._c2p_cron_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
