<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form_c2p" model="ir.ui.view">
        <field name="name">project.task.form.c2p</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">

                <page name="c2p_milestone" string="Milestone"
                      invisible="not c2p_is_milestone">
                    <group>
                        <group>
                            <field name="c2p_is_milestone" invisible="1"/>
                            <field name="c2p_code"/>
                            <field name="weight"/>
                            <field name="delivery_milestone_id"
                                   options="{'no_create': True}"/>
                            <field name="sync_locked"
                                   groups="c2p_project_tracker.group_c2p_portfolio_manager"/>
                        </group>
                        <group>
                            <field name="baseline_deadline"/>
                            <field name="slippage_days"
                                   decoration-danger="slippage_days > 7"/>
                            <button name="action_reset_baseline" type="object"
                                    string="Reset baseline" class="btn-link"
                                    confirm="Resetting the baseline erases the slippage history for this milestone. Continue?"
                                    groups="c2p_project_tracker.group_c2p_portfolio_manager"/>
                        </group>
                    </group>
                    <group string="Billing">
                        <group>
                            <field name="c2p_company_currency_id" invisible="1"/>
                            <field name="billing_pct"/>
                            <field name="billing_amount"/>
                        </group>
                        <group>
                            <field name="invoice_status"/>
                        </group>
                    </group>
                </page>

                <page name="c2p_delivery" string="Delivery"
                      invisible="c2p_is_milestone">
                    <group>
                        <group>
                            <field name="blocked_reason"
                                   placeholder="What is the client holding up?"/>
                            <field name="waiting_since"/>
                        </group>
                        <group>
                            <field name="outsourced"/>
                            <field name="vendor_id" invisible="not outsourced"
                                   required="outsourced"/>
                        </group>
                    </group>
                </page>

            </xpath>
        </field>
    </record>

    <!-- Data hygiene queue: the three things a delivery task must have. -->
    <record id="view_task_list_c2p_hygiene" model="ir.ui.view">
        <field name="name">project.task.list.c2p.hygiene</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <list string="Tasks needing attention" editable="bottom">
                <field name="name"/>
                <field name="project_id"/>
                <field name="stage_id"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="date_deadline"/>
                <field name="milestone_id"/>
                <field name="blocked_reason" optional="show"/>
                <field name="waiting_since" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_task_search_c2p" model="ir.ui.view">
        <field name="name">project.task.search.c2p</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <search string="Delivery tasks">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_ids"/>
                <filter name="no_assignee" string="No assignee"
                        domain="[('user_ids', '=', False)]"/>
                <filter name="no_deadline" string="No deadline"
                        domain="[('date_deadline', '=', False)]"/>
                <filter name="no_milestone" string="No milestone"
                        domain="[('milestone_id', '=', False)]"/>
                <separator/>
                <filter name="waiting_no_reason"
                        string="Waiting on client, no reason given"
                        domain="[('waiting_since', '!=', False),
                                 ('blocked_reason', '=', False)]"/>
                <filter name="blocked" string="Waiting on client"
                        domain="[('waiting_since', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_assignee" string="Assignee"
                            context="{'group_by': 'user_ids'}"/>
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_milestone" string="Milestone"
                            context="{'group_by': 'milestone_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_c2p_hygiene" model="ir.actions.act_window">
        <field name="name">Data hygiene</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_task_list_c2p_hygiene"/>
        <field name="search_view_id" ref="view_task_search_c2p"/>
        <field name="domain">
            [('project_id.c2p_layer', '=', 'delivery'),
             '|', '|', '|',
             ('user_ids', '=', False),
             ('date_deadline', '=', False),
             ('milestone_id', '=', False),
             '&amp;', ('waiting_since', '!=', False),
                      ('blocked_reason', '=', False)]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to fix</p>
            <p>Every delivery task has an assignee, a deadline and a milestone,
               and every blocked task says why.</p>
        </field>
    </record>

    <record id="action_c2p_team_load" model="ir.actions.act_window">
        <field name="name">Team load</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_task_search_c2p"/>
        <field name="domain">
            [('project_id.c2p_layer', '=', 'delivery'),
             ('stage_id.fold', '=', False)]
        </field>
        <field name="context">{'search_default_group_assignee': 1}</field>
    </record>

</odoo>
