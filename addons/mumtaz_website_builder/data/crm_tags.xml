<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tag_mumtaz_erp" model="crm.tag"><field name="name">Mumtaz ERP</field></record>
        <record id="tag_industry" model="crm.tag"><field name="name">Industry solution</field></record>
        <record id="tag_white_label" model="crm.tag"><field name="name">White-label ERP</field></record>
        <record id="tag_zaki" model="crm.tag"><field name="name">ZAKI AI</field></record>
    </data>
    <data>
        <!-- The native website form may write the chosen solution as a lead tag;
             website_crm whitelists contact/company/email/phone/description already. -->
        <function model="ir.model.fields" name="formbuilder_whitelist">
            <value>crm.lead</value>
            <value eval="['tag_ids']"/>
        </function>
    </data>
</odoo>
