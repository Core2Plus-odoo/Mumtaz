<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Company scope, following the allowed-companies switcher, on every
             model this module adds. -->
        <record id="rule_onboarding_check_company" model="ir.rule">
            <field name="name">Onboarding check: allowed companies</field>
            <field name="model_id" ref="model_c2p_onboarding_check"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_client_instance_company" model="ir.rule">
            <field name="name">Client instance: allowed companies</field>
            <field name="model_id" ref="model_c2p_client_instance"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_client_document_company" model="ir.rule">
            <field name="name">Client document: allowed companies</field>
            <field name="model_id" ref="model_c2p_client_document"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_client_access_company" model="ir.rule">
            <field name="name">Client access: allowed companies</field>
            <field name="model_id" ref="model_c2p_client_access"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Access register: a Delivery Member sees only the access they hold
             themselves. Leads and managers see the whole register. Group
             rules are OR-ed, so the lead rule widens the member rule. -->
        <record id="rule_client_access_member_own" model="ir.rule">
            <field name="name">Client access: member sees own</field>
            <field name="model_id" ref="model_c2p_client_access"/>
            <field name="domain_force">[('holder_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('c2p_project_tracker.group_c2p_delivery_member'))]"/>
        </record>
        <record id="rule_client_access_lead_all" model="ir.rule">
            <field name="name">Client access: lead sees all</field>
            <field name="model_id" ref="model_c2p_client_access"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('c2p_project_tracker.group_c2p_delivery_lead'))]"/>
        </record>

    </data>
</odoo>
