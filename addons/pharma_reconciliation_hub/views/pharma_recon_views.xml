<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_recon_run_list" model="ir.ui.view">
        <field name="name">pharma.recon.run.list</field>
        <field name="model">pharma.recon.run</field>
        <field name="arch" type="xml">
            <list string="Reconciliation Runs" decoration-danger="open_exceptions &gt; 0">
                <field name="name"/><field name="run_type"/><field name="period"/><field name="state"/>
                <field name="source_total" sum="Source"/><field name="expected_bank" sum="Expected"/>
                <field name="bank_total" sum="Bank"/><field name="variance" sum="Variance"/>
                <field name="open_exceptions" sum="Open exceptions"/><field name="is_demo" string="DEMO"/>
            </list>
        </field>
    </record>
    <record id="view_pharma_recon_run_form" model="ir.ui.view">
        <field name="name">pharma.recon.run.form</field>
        <field name="model">pharma.recon.run</field>
        <field name="arch" type="xml">
            <form string="Reconciliation Run">
                <header>
                    <button name="action_match" type="object" string="Run matching" class="btn-primary"
                            groups="pharma_core.group_pharma_finance"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="run_type"/><field name="period"/>
                            <field name="date_window_days"/><field name="is_demo"/></group>
                        <group>
                            <field name="source_total"/><field name="authorized_deductions"/>
                            <field name="expected_bank"/><field name="bank_total"/>
                            <field name="variance" decoration-danger="variance != 0"/>
                            <field name="open_exceptions"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="item_ids">
                                <list editable="bottom" decoration-danger="state == 'exception'"
                                      decoration-success="state == 'matched'">
                                    <field name="side"/><field name="item_ref"/><field name="batch_ref"/>
                                    <field name="amount"/><field name="item_date"/>
                                    <field name="source_label"/><field name="raw_event_id"/>
                                    <field name="state"/><field name="method"/>
                                </list>
                            </field>
                        </page>
                        <page string="Exceptions" name="exceptions">
                            <field name="exception_ids" readonly="1">
                                <list><field name="description"/><field name="amount"/>
                                    <field name="owner_id"/><field name="state"/></list>
                            </field>
                        </page>
                        <page string="Distribution Partner Stock" name="stock" invisible="run_type != 'partner_stock'">
                            <field name="stock_line_ids"/>
                        </page>
                    </notebook>
                    <p class="text-muted">A variance is never forced to zero. It opens an exception with an owner.</p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharma_recon_run" model="ir.actions.act_window">
        <field name="name">Reconciliation Runs</field>
        <field name="res_model">pharma.recon.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pharma_recon_exception_list" model="ir.ui.view">
        <field name="name">pharma.recon.exception.list</field>
        <field name="model">pharma.recon.exception</field>
        <field name="arch" type="xml">
            <list string="Exception Queue" decoration-danger="state == 'open' and not owner_id"
                  decoration-muted="state == 'closed'">
                <field name="run_id"/><field name="description"/><field name="amount" sum="Total"/>
                <field name="owner_id"/><field name="state"/><field name="resolution"/>
                <field name="is_demo" string="DEMO"/>
            </list>
        </field>
    </record>
    <record id="view_pharma_recon_exception_form" model="ir.ui.view">
        <field name="name">pharma.recon.exception.form</field>
        <field name="model">pharma.recon.exception</field>
        <field name="arch" type="xml">
            <form string="Exception">
                <header>
                    <button name="action_assign_to_me" type="object" string="Take ownership"
                            invisible="state != 'open'"/>
                    <button name="action_propose_close" type="object" string="Propose closure"
                            invisible="state not in ('open','investigating')"/>
                    <button name="action_approve_close" type="object" string="Approve closure"
                            class="btn-primary" invisible="state != 'pending_approval'"
                            groups="pharma_core.group_pharma_finance"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="run_id"/><field name="bank_item_id"/>
                            <field name="description"/><field name="amount"/></group>
                        <group><field name="owner_id"/><field name="resolution"/><field name="proposed_by"/>
                            <field name="approved_by"/><field name="is_demo"/></group>
                    </group>
                    <field name="note" placeholder="Resolution note (required to close)"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_pharma_recon_exception" model="ir.actions.act_window">
        <field name="name">Exception Queue</field>
        <field name="res_model">pharma.recon.exception</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'closed')]</field>
    </record>
</odoo>
