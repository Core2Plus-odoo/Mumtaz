<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reading the audit is a manager's job; writing it is the system's
         (the controller writes with sudo on its own cursor). Nobody edits
         or deletes audit rows through the ORM. -->
    <record id="rule_api_audit_company" model="ir.rule">
        <field name="name">API audit: own company</field>
        <field name="model_id" ref="model_jewellery_api_audit"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('user_id.company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
