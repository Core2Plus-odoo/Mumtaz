<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Company scoping: plans, rate cards and their lines never cross
         companies; outlets are shared only when they carry no company. -->
    <record id="rule_media_plan_company" model="ir.rule">
        <field name="name">Media plans: own companies</field>
        <field name="model_id" ref="model_media_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_media_plan_line_company" model="ir.rule">
        <field name="name">Media plan lines: own companies</field>
        <field name="model_id" ref="model_media_plan_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_media_rate_card_company" model="ir.rule">
        <field name="name">Rate cards: own companies</field>
        <field name="model_id" ref="model_media_rate_card"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_media_rate_card_line_company" model="ir.rule">
        <field name="name">Rate card lines: own companies</field>
        <field name="model_id" ref="model_media_rate_card_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_media_outlet_company" model="ir.rule">
        <field name="name">Outlets: own companies or shared</field>
        <field name="model_id" ref="model_media_outlet"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
