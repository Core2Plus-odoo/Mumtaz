<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_owner_card_restricted" model="ir.rule">
        <field name="name">Owner cards: VIP-client cards for VIP managers only</field>
        <field name="model_id" ref="model_jewellery_owner_card"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('mumtaz_jewellery_vip.group_vip_manager') else [('restricted', '=', False)]</field>
    </record>
</odoo>
