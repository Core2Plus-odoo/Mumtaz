<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Work queue: every parcel that still needs someone, grouped by what that someone has to do. -->
    <record id="view_pharma_courier_shipment_queue_search" model="ir.ui.view">
        <field name="name">pharma.courier.shipment.queue.search</field>
        <field name="model">pharma.courier.shipment</field>
        <field name="arch" type="xml">
            <search string="Work Queue">
                <field name="tracking_number"/><field name="order_ref"/><field name="courier_id"/>
                <filter name="open_work" string="Needs action" domain="[('flow_next', 'not in', ('none',))]"/>
                <separator/>
                <filter name="owner_ops" string="Operations" domain="[('flow_owner', '=', 'ops')]"/>
                <filter name="owner_finance" string="Finance Controller" domain="[('flow_owner', '=', 'finance')]"/>
                <filter name="owner_accountant" string="Accountant" domain="[('flow_owner', '=', 'accountant')]"/>
                <separator/>
                <filter name="overdue" string="Overdue" domain="[('cod_is_overdue', '=', True)]"/>
                <group>
                    <filter name="group_next" string="Next step" context="{'group_by': 'flow_next'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'flow_owner'}"/>
                    <filter name="group_courier" string="Courier" context="{'group_by': 'courier_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'flow_stage'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_pharma_courier_queue" model="ir.actions.act_window">
        <field name="name">Work Queue</field>
        <field name="res_model">pharma.courier.shipment</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_pharma_courier_shipment_queue_search"/>
        <field name="context">{'search_default_open_work': 1, 'search_default_group_next': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing needs action.</p>
            <p>Every parcel that still needs someone appears here, grouped by the step it is waiting for.</p></field>
    </record>

    <!-- Pipeline: where every parcel is on the one path, by courier, with the money outstanding. -->
    <record id="view_pharma_courier_shipment_pipeline_pivot" model="ir.ui.view">
        <field name="name">pharma.courier.shipment.pipeline.pivot</field>
        <field name="model">pharma.courier.shipment</field>
        <field name="arch" type="xml">
            <pivot string="Pipeline">
                <field name="flow_stage" type="row"/>
                <field name="courier_id" type="col"/>
                <field name="cod_outstanding" type="measure"/>
                <field name="cod_collected" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_pharma_courier_pipeline" model="ir.actions.act_window">
        <field name="name">Pipeline</field>
        <field name="res_model">pharma.courier.shipment</field>
        <field name="view_mode">pivot,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_pharma_courier_shipment_pipeline_pivot')})]"/>
        <field name="search_view_id" ref="view_pharma_courier_shipment_queue_search"/>
    </record>
</odoo>
