<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- How far ahead the Outreach screen looks for occasions. Drafts follow
         each occasion's own lead time, not this window. -->
    <record id="param_outreach_days" model="ir.config_parameter">
        <field name="key">mumtaz_jewellery.outreach_days</field>
        <field name="value">45</field>
    </record>
    <!-- Each morning: Layla drafts the occasion messages due, for a person to
         review. Nothing is sent by this job. -->
    <record id="cron_outreach_prepare" model="ir.cron">
        <field name="name">Jawhar: draft the occasion messages due (Layla)</field>
        <field name="model_id" ref="mumtaz_jewellery_ai.model_jewellery_ai_agent"/>
        <field name="state">code</field>
        <field name="code">model.outreach_prepare()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
