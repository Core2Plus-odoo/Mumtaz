<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mumtaz_product_list" model="ir.ui.view">
            <field name="name">mumtaz.product.list</field>
            <field name="model">mumtaz.product</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'available'"
                           decoration-warning="status == 'pilot'"
                           decoration-muted="status == 'planned'"/>
                    <field name="delivery_mode"/>
                    <field name="self_service"/>
                </list>
            </field>
        </record>

        <record id="view_mumtaz_product_form" model="ir.ui.view">
            <field name="name">mumtaz.product.form</field>
            <field name="model">mumtaz.product</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                            <field name="summary" placeholder="One line on what it is"/>
                        </div>
                        <group>
                            <group string="Identity">
                                <field name="code"/>
                                <field name="category"/>
                                <field name="delivery_mode"/>
                                <field name="active"/>
                            </group>
                            <group string="Readiness">
                                <field name="status"/>
                                <field name="self_service"/>
                                <field name="bundle_id"/>
                                <field name="access_feature_id"/>
                            </group>
                        </group>
                        <group string="Basis for the Status">
                            <field name="evidence" nolabel="1" colspan="2"
                                   placeholder="The test, deployment or review the status rests on"/>
                        </group>
                        <notebook>
                            <page string="Plans">
                                <field name="plan_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="list_price"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="trial_days"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mumtaz_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">mumtaz.product</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_mumtaz_plan_form_product" model="ir.ui.view">
            <field name="name">mumtaz.plan.form.product</field>
            <field name="model">mumtaz.plan</field>
            <field name="inherit_id" ref="view_mumtaz_plan_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="product_id"/>
                    <field name="trial_days"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
