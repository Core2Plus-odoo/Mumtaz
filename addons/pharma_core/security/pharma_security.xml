<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_pharma_user" model="res.groups">
            <field name="name">Pharma: Operations User</field>
            <field name="comment">View reconciliation, tax and partner data; raise exceptions.</field>
        </record>
        <record id="group_pharma_finance" model="res.groups">
            <field name="name">Pharma: Finance Controller</field>
            <field name="comment">Run matching, assign and close exceptions, approve settlements.</field>
            <field name="implied_ids" eval="[(4, ref('group_pharma_user'))]"/>
        </record>
        <record id="group_pharma_tax_approver" model="res.groups">
            <field name="name">Pharma: Tax Approver</field>
            <field name="comment">Approve tax rules and SKU tax classifications (maker-checker). Separate from Finance.</field>
            <field name="implied_ids" eval="[(4, ref('group_pharma_user'))]"/>
        </record>
        <record id="group_pharma_admin" model="res.groups">
            <field name="name">Pharma: Administrator</field>
            <field name="comment">Configuration. Does not imply tax approval or finance sign-off.</field>
            <field name="implied_ids" eval="[(4, ref('group_pharma_user'))]"/>
        </record>
    </data>
</odoo>
