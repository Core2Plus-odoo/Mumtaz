<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_kiosk_request" model="ir.sequence">
        <field name="name">Kiosk request</field>
        <field name="code">jewellery.kiosk.request</field>
        <field name="prefix">KSK/</field>
        <field name="padding">5</field>
    </record>
    <!-- Requests one phone number may place in a day. -->
    <record id="param_kiosk_daily_cap" model="ir.config_parameter">
        <field name="key">mumtaz_jewellery.kiosk_daily_cap</field>
        <field name="value">3</field>
    </record>
    <!-- The ElevenLabs conversational agent behind the kiosk (public id). -->
    <record id="param_voice_agent_noor" model="ir.config_parameter">
        <field name="key">mumtaz_jewellery.voice_agent_noor</field>
        <field name="value">agent_6601m75aq9cdepjthkha0k8c7yzw</field>
    </record>
</odoo>
