<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The feed runs hourly and only ever drafts; a person approves. -->
    <record id="cron_rate_feed" model="ir.cron">
        <field name="name">Jawhar: read the gold rate feed (draft for approval)</field>
        <field name="model_id" ref="model_jewellery_rate_feed"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
