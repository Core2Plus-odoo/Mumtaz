<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================================
         C2P Proposal - clean corporate A4 PDF. Cover page + numbered
         sections. Table-based layout (wkhtmltopdf-safe), UTF-8 via
         web.basic_layout (no letterhead), ASCII-safe glyphs.
         ================================================================== -->

    <record id="paperformat_c2p_proposal" model="report.paperformat">
        <field name="name">C2P Proposal A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_c2p_proposal" model="ir.actions.report">
        <field name="name">Proposal</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">c2p_proposal.report_proposal_document</field>
        <field name="report_file">c2p_proposal.report_proposal_document</field>
        <field name="print_report_name">'C2P x %s' % (object.partner_id.name or object.name)</field>
        <field name="paperformat_id" ref="paperformat_c2p_proposal"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_proposal_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id"/>
                <t t-call="web.basic_layout">
                <div class="o_c2p">
                    <style>
                        .o_c2p { color:#2b2b2b; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
                            font-size:13px; }
                        .o_c2p .mut { color:#6b6b6b; }
                        /* Cover */
                        .o_c2p .cvtop { background:#6d3f5f; color:#fff; padding:44px 44px 38px; }
                        .o_c2p .cvtop .lg { font-weight:800; font-size:22px; }
                        .o_c2p .cvtop .sm { font-weight:400; font-size:10px; letter-spacing:3px;
                            opacity:.82; margin-top:5px; }
                        .o_c2p .cvgold { height:5px; background:#B8862A; }
                        .o_c2p .cvbody { padding:60px 4px 0; }
                        .o_c2p .cvkick { letter-spacing:6px; font-size:13px; color:#B8862A; font-weight:700; }
                        .o_c2p .cvtitle { font-size:38px; font-weight:800; color:#2b2b2b; line-height:1.14;
                            margin:14px 0 10px; }
                        .o_c2p .cvsub { font-size:15px; color:#6b6b6b; }
                        .o_c2p .cvfor { margin-top:48px; }
                        .o_c2p .cvfor .lbl { font-size:11px; letter-spacing:2px; text-transform:uppercase;
                            color:#9a8b95; }
                        .o_c2p .cvfor .v { font-size:21px; font-weight:700; color:#6d3f5f; margin-top:3px; }
                        .o_c2p .cvmeta { margin-top:280px; border-top:1px solid #e2dae0; padding-top:16px;
                            width:100%; }
                        .o_c2p .cvmeta td { width:25%; vertical-align:top; padding-right:12px; }
                        .o_c2p .cvmeta .k { font-size:10px; letter-spacing:1px; text-transform:uppercase;
                            color:#9a8b95; }
                        .o_c2p .cvmeta .val { font-weight:600; color:#3d353b; font-size:13px; margin-top:2px; }
                        /* Sections */
                        .o_c2p .sec { margin-top:24px; page-break-inside:avoid; }
                        .o_c2p .sec-h { border-bottom:1px solid #e2dae0; padding-bottom:7px; margin-bottom:12px; }
                        .o_c2p .sec-n { font-size:13px; font-weight:800; color:#B8862A; margin-right:10px; }
                        .o_c2p .sec-t { font-size:16px; font-weight:700; color:#6d3f5f; }
                        .o_c2p p { line-height:1.6; font-size:13px; margin:0 0 8px; }
                        .o_c2p .two { width:100%; border-collapse:separate; border-spacing:24px 0; }
                        .o_c2p .two td { width:50%; vertical-align:top; }
                        .o_c2p .subh { font-size:11.5px; font-weight:700; color:#54304a; text-transform:uppercase;
                            letter-spacing:.5px; margin-bottom:8px; }
                        .o_c2p ul.clean { list-style:none; margin:0; padding:0; }
                        .o_c2p ul.clean li { padding-left:16px; margin-bottom:7px; font-size:12.5px;
                            line-height:1.5; position:relative; }
                        .o_c2p ul.clean li .d { position:absolute; left:0; top:6px; width:6px; height:6px;
                            background:#B8862A; border-radius:50%; }
                        .o_c2p .ben { width:100%; border-collapse:separate; border-spacing:24px 12px; }
                        .o_c2p .ben td { width:50%; vertical-align:top; }
                        .o_c2p .bt { font-weight:700; font-size:12.5px; color:#54304a; }
                        .o_c2p .bd { font-size:12px; color:#6b6b6b; line-height:1.5; margin-top:1px; }
                        .o_c2p table.tbl { width:100%; border-collapse:collapse; font-size:12.5px; }
                        .o_c2p table.tbl th { background:#6d3f5f; color:#fff; text-align:left; padding:9px 12px;
                            font-weight:600; font-size:12px; }
                        .o_c2p table.tbl td { border-bottom:1px solid #e2dae0; padding:9px 12px;
                            vertical-align:top; }
                        .o_c2p .r { text-align:right; }
                        .o_c2p table.phase { width:100%; border-collapse:collapse; }
                        .o_c2p table.phase td { padding:10px 0; border-bottom:1px solid #e2dae0;
                            vertical-align:top; }
                        .o_c2p .pn { width:28px; height:28px; background:#6d3f5f; color:#fff; border-radius:50%;
                            text-align:center; line-height:28px; font-weight:700; font-size:13px;
                            display:inline-block; }
                        .o_c2p .pt { font-weight:700; font-size:13px; color:#2b2b2b; }
                        .o_c2p .pd { font-size:12px; color:#6b6b6b; line-height:1.5; margin-top:2px; }
                        .o_c2p .callout { border-left:3px solid #B8862A; background:#faf6ef; padding:11px 15px;
                            font-size:12.5px; margin-top:12px; }
                        .o_c2p .totbox { background:#6d3f5f; color:#fff; padding:11px 20px; border-radius:4px; }
                        .o_c2p .totbox .tl { font-size:13px; opacity:.9; }
                        .o_c2p .totbox .tv { font-size:19px; font-weight:800; }
                        .o_c2p .note { font-size:11px; color:#8a8a8a; font-style:italic; margin-top:9px; }
                        .o_c2p table.sign { width:100%; border-collapse:separate; border-spacing:44px 0;
                            margin-top:40px; }
                        .o_c2p table.sign td { border-top:1px solid #b7abb2; padding-top:8px; font-size:12px;
                            color:#6b6b6b; width:50%; }
                        .o_c2p .foot { border-top:1px solid #e2dae0; padding-top:8px; margin-top:28px;
                            text-align:center; font-size:10px; color:#9a9a9a; }
                    </style>

                    <!-- ===== COVER ===== -->
                    <div class="cvtop">
                        <div class="lg"><span t-field="doc.company_id.name"/></div>
                        <div class="sm">OFFICIAL ODOO PARTNER &#183; GCC &amp; PAKISTAN</div>
                    </div>
                    <div class="cvgold"></div>
                    <div class="cvbody">
                        <div class="cvkick">PROPOSAL</div>
                        <div class="cvtitle"><span t-field="doc.c2p_proposal_title"/></div>
                        <div class="cvsub">A unified platform for your operations, finance and growth.</div>
                        <div class="cvfor">
                            <div class="lbl">Prepared for</div>
                            <div class="v"><span t-field="doc.partner_id.name"/></div>
                            <div class="mut" style="font-size:12px; margin-top:2px;" t-if="doc.c2p_industry">
                                <span t-field="doc.c2p_industry"/></div>
                        </div>
                    </div>
                    <table class="cvmeta">
                        <tr>
                            <td><div class="k">Prepared by</div><div class="val"><span t-field="doc.company_id.name"/></div></td>
                            <td><div class="k">Reference</div><div class="val"><span t-field="doc.name"/></div></td>
                            <td><div class="k">Date</div><div class="val"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></div></td>
                            <td><div class="k">Valid until</div><div class="val"><span t-field="doc.validity_date" t-options='{"widget": "date"}'/></div></td>
                        </tr>
                    </table>

                    <p style="page-break-after:always;"></p>

                    <!-- ===== 01 EXECUTIVE SUMMARY ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">01</span><span class="sec-t">Executive Summary</span></div>
                        <p t-if="doc.c2p_exec_summary" style="white-space:pre-line;"><span t-field="doc.c2p_exec_summary"/></p>
                        <p t-else="">
                            <span t-field="doc.company_id.name"/> is pleased to present this proposal to
                            <b><span t-field="doc.partner_id.name"/></b> for the implementation of a fully
                            integrated Odoo ERP. This document sets out our understanding of your requirements,
                            the proposed solution, our delivery methodology, indicative timeline and a
                            transparent commercial proposal. Our approach is standard-first: we configure native
                            Odoo before any customisation, keeping cost down and future upgrades smooth.
                        </p>
                    </div>

                    <!-- ===== 02 UNDERSTANDING ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">02</span><span class="sec-t">Understanding Your Requirements</span></div>
                        <table class="two"><tr>
                            <td>
                                <div class="subh">Current challenges</div>
                                <ul class="clean">
                                    <li t-foreach="doc._c2p_pain_list()" t-as="p"><span class="d"></span><span t-out="p"/></li>
                                </ul>
                            </td>
                            <td>
                                <div class="subh">Objectives</div>
                                <ul class="clean">
                                    <li t-foreach="doc._c2p_objective_list()" t-as="ob"><span class="d"></span><span t-out="ob"/></li>
                                </ul>
                            </td>
                        </tr></table>
                    </div>

                    <!-- ===== 03 KEY BENEFITS ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">03</span><span class="sec-t">Key Business Benefits</span></div>
                        <table class="ben">
                            <tr t-foreach="doc._c2p_benefit_rows()" t-as="row">
                                <td t-foreach="row" t-as="b">
                                    <div class="bt"><span t-out="b['title']"/></div>
                                    <div class="bd"><span t-out="b['desc']"/></div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ===== 04 SOLUTION & MODULES ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">04</span><span class="sec-t">Proposed Solution &amp; In-Scope Modules</span></div>
                        <p class="mut">We follow a standard-first approach &#8212; configuring native Odoo before any customisation.</p>
                        <table class="tbl">
                            <tr><th style="width:36%;">Module / Service</th><th>Scope</th></tr>
                            <tr t-foreach="doc.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                <td><b><span t-field="line.product_id.name"/></b></td>
                                <td><span t-field="line.name"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- ===== 05 METHODOLOGY ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">05</span><span class="sec-t">Implementation Methodology</span></div>
                        <table class="phase">
                            <tr t-foreach="doc._c2p_methodology()" t-as="ph">
                                <td style="width:44px;"><span class="pn"><span t-out="ph['n']"/></span></td>
                                <td><div class="pt"><span t-out="ph['name']"/></div>
                                    <div class="pd"><span t-out="ph['desc']"/></div></td>
                            </tr>
                        </table>
                        <div class="callout"><b>Indicative timeline:</b>
                            <span t-out="doc.c2p_timeline_weeks"/> weeks from kick-off to go-live, phased and
                            confirmed during Discovery.</div>
                    </div>

                    <!-- ===== 06 DELIVERABLES ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">06</span><span class="sec-t">Deliverables</span></div>
                        <table class="two"><tr>
                            <td><ul class="clean">
                                <li t-foreach="doc._c2p_deliverables()[:3]" t-as="d"><span class="d"></span><span t-out="d"/></li>
                            </ul></td>
                            <td><ul class="clean">
                                <li t-foreach="doc._c2p_deliverables()[3:]" t-as="d"><span class="d"></span><span t-out="d"/></li>
                            </ul></td>
                        </tr></table>
                    </div>

                    <!-- ===== 07 ROLES ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">07</span><span class="sec-t">Roles &amp; Responsibilities</span></div>
                        <table class="tbl">
                            <tr><th style="width:26%;">Party</th><th>Responsibilities</th></tr>
                            <tr t-foreach="doc._c2p_roles()" t-as="r">
                                <td><b><span t-out="r['party']"/></b></td>
                                <td><span t-out="r['resp']"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- ===== 08 ASSUMPTIONS ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">08</span><span class="sec-t">Assumptions &amp; Conditions</span></div>
                        <ul class="clean">
                            <li t-foreach="doc._c2p_assumptions()" t-as="a"><span class="d"></span><span t-out="a"/></li>
                        </ul>
                    </div>

                    <!-- ===== 09 COMMERCIAL ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">09</span><span class="sec-t">Commercial Proposal</span></div>
                        <table class="tbl">
                            <tr><th style="width:50%;">Item</th><th class="r">Qty</th><th class="r">Unit Price</th><th class="r">Amount</th></tr>
                            <tr t-foreach="doc.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                                <td><span t-field="line.product_id.name"/></td>
                                <td class="r"><span t-field="line.product_uom_qty"/></td>
                                <td class="r"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                <td class="r"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr><td colspan="3" class="r">Subtotal</td>
                                <td class="r"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td></tr>
                            <tr><td colspan="3" class="r">Taxes</td>
                                <td class="r"><span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td></tr>
                        </table>
                        <table style="width:100%; margin-top:12px;"><tr>
                            <td></td>
                            <td style="width:290px;">
                                <div class="totbox"><table style="width:100%"><tr>
                                    <td class="tl">Total</td>
                                    <td class="r tv"><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr></table></div>
                            </td>
                        </tr></table>
                        <div t-if="doc.c2p_hosting_note" class="note"><span t-field="doc.c2p_hosting_note"/></div>
                    </div>

                    <!-- ===== AMC (optional) ===== -->
                    <div class="sec" t-if="doc.c2p_amc_monthly">
                        <div class="sec-h"><span class="sec-t">Annual Maintenance &amp; Support (AMC)</span></div>
                        <table style="width:100%;"><tr>
                            <td style="vertical-align:middle; font-size:12.5px;">Post go-live support, issue
                                resolution, minor enhancements and periodic health checks under an Annual
                                Maintenance Contract.</td>
                            <td class="r" style="width:170px; vertical-align:middle;">
                                <span style="font-size:18px; font-weight:800; color:#6d3f5f;">
                                    <span t-field="doc.c2p_amc_monthly" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></span>
                                <div class="mut" style="font-size:10px;">per month</div>
                            </td>
                        </tr></table>
                    </div>

                    <!-- ===== 10 WHY C2P ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">10</span><span class="sec-t">Why <span t-field="doc.company_id.name"/></span></div>
                        <table class="ben">
                            <tr t-foreach="doc._c2p_why_rows()" t-as="row">
                                <td t-foreach="row" t-as="w">
                                    <div class="bt"><span t-out="w['title']"/></div>
                                    <div class="bd"><span t-out="w['desc']"/></div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ===== 11 NEXT STEPS ===== -->
                    <div class="sec">
                        <div class="sec-h"><span class="sec-n">11</span><span class="sec-t">Conclusion &amp; Next Steps</span></div>
                        <table class="phase">
                            <tr t-foreach="doc._c2p_next_steps()" t-as="s">
                                <td style="width:44px;"><span class="pn"><span t-out="s_index + 1"/></span></td>
                                <td style="vertical-align:middle;"><span t-out="s"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- ===== SIGNATURE ===== -->
                    <table class="sign"><tr>
                        <td>Accepted for <b><span t-field="doc.partner_id.name"/></b><br/><br/><br/>Name / Title / Date</td>
                        <td>For <b><span t-field="doc.company_id.name"/></b><br/><br/><br/>Name / Title / Date</td>
                    </tr></table>

                    <div class="foot">
                        <span t-if="doc.company_id.report_footer" t-field="doc.company_id.report_footer"/>
                        <t t-else=""><span t-field="doc.company_id.name"/> &#183; core2plus.com</t>
                    </div>
                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
