                                <td><div class="sect serif">Why <span t-field="doc.company_id.name"/> &amp; Next Steps</div><div class="u"></div></td>
                            </tr></table>
                            <table class="cards">
                                <tr t-foreach="doc._c2p_why_rows()" t-as="row">
