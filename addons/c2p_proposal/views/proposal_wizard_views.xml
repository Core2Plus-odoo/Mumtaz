<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c2p_proposal_wizard_form" model="ir.ui.view">
        <field name="name">c2p.proposal.wizard.form</field>
        <field name="model">c2p.proposal.wizard</field>
        <field name="arch" type="xml">
            <form string="Proposal Maker">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="proposal_title" placeholder="Proposal title..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="industry"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="validity_days"/>
                            <field name="timeline_weeks"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amc_monthly"/>
                            <field name="open_pdf"/>
                        </group>
                    </group>
                    <separator string="Tick the services / modules to include"/>
                    <field name="service_ids" widget="many2many_checkboxes"/>
                    <notebook>
                        <page string="Executive summary">
                            <field name="exec_summary"
                                   placeholder="Leave blank to auto-generate a summary..."/>
                        </page>
                        <page string="Pain points">
                            <field name="pain_points"
                                   placeholder="One challenge per line. Blank = sensible defaults."/>
                        </page>
                        <page string="Objectives">
                            <field name="objectives"
                                   placeholder="One objective per line. Blank = sensible defaults."/>
                        </page>
                        <page string="Notes">
                            <field name="note"
                                   placeholder="Optional scope summary shown on the quotation..."/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Proposal" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_c2p_proposal_wizard" model="ir.actions.act_window">
        <field name="name">Proposal Maker</field>
        <field name="res_model">c2p.proposal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_c2p_proposal"
              name="Proposal Maker"
              parent="sale.sale_menu_root"
              action="action_c2p_proposal_wizard"
              sequence="4"/>
</odoo>
