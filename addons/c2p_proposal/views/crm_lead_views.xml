<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add a "Proposal Maker" button to the opportunity header so a sales
         executive can generate a proposal straight from CRM, with the
         customer and opportunity context pulled in automatically. -->
    <record id="crm_lead_view_form_c2p_proposal" model="ir.ui.view">
        <field name="name">crm.lead.form.c2p.proposal</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_c2p_proposal_wizard)d" type="action"
                        string="Proposal Maker" class="btn-secondary"
                        context="{'default_lead_id': id, 'default_partner_id': partner_id}"/>
            </xpath>
        </field>
    </record>
</odoo>
