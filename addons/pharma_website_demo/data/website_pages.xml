<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pharma_home" name="Pharma DEMO home">
        <t t-call="website.layout">
            <t t-set="additional_title">Pharma Demo Co — everyday wellness (DEMO)</t>
            <t t-set="pw_products" t-value="bool(request) and request.env['product.template'].sudo().search([('is_published', '=', True), ('default_code', '=like', 'DEMO-SKU-%')], order='website_sequence, id', limit=5)"/>
            <div id="wrap" class="oe_structure">

                <!-- hero -->
                <section class="pw-hero">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <span class="pw-eyebrow">Pharma Demo Co · DEMO storefront</span>
                                <h1>Everyday wellness, <em>kept honest.</em></h1>
                                <p class="pw-lead">
                                    A small, calm catalogue of teas and blends. Behind the shop sits a back office where no tax
                                    rate is ever assumed, no cash difference is quietly written off, and every change is checked
                                    by a second pair of eyes.
                                </p>
                                <div class="mt-4 d-flex flex-wrap gap-2">
                                    <a href="/shop" class="btn btn-primary btn-lg">Browse the shop</a>
                                    <a href="/web/login" class="btn btn-outline-primary btn-lg">Open the back office</a>
                                </div>
                                <p class="small mt-4 mb-0" style="color:#6b786f">Every product, price and number here is fictional.</p>
                            </div>
                            <div class="col-lg-6">
                                <div class="pw-hero-art" t-if="pw_products and len(pw_products) &gt;= 3">
                                    <t t-foreach="pw_products[:3]" t-as="hp">
                                        <img t-attf-src="/web/image/product.template/#{hp.id}/image_512" t-att-alt="hp.name" loading="eager"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- trust strip -->
                <section class="pw-trust">
                    <div class="container">
                        <div class="row">
                            <div class="col-6 col-lg-3 pw-trust-item">
                                <svg viewBox="0 0 40 40"><path d="M8 20c0-8 6-14 14-14h10v10c0 8-6 14-14 14H8z"/><path d="M8 32 22 18"/></svg>
                                <div><strong>Checked at checkout</strong><span>Tax treatment must be approved</span></div>
                            </div>
                            <div class="col-6 col-lg-3 pw-trust-item">
                                <svg viewBox="0 0 40 40"><rect x="6" y="12" width="28" height="18" rx="4"/><circle cx="20" cy="21" r="4"/><path d="M6 17h4M30 17h4"/></svg>
                                <div><strong>Cash that adds up</strong><span>Courier, gateway and bank matched</span></div>
                            </div>
                            <div class="col-6 col-lg-3 pw-trust-item">
                                <svg viewBox="0 0 40 40"><path d="M6 14 20 6l14 8v14L20 36 6 28z"/><path d="M6 14l14 8 14-8M20 22v14"/></svg>
                                <div><strong>Partner stock counted</strong><span>Every lot rolled forward</span></div>
                            </div>
                            <div class="col-6 col-lg-3 pw-trust-item">
                                <svg viewBox="0 0 40 40"><circle cx="15" cy="15" r="6"/><circle cx="27" cy="17" r="5"/><path d="M4 33c1-6 5-9 11-9s10 3 11 9M24 25c5 0 9 2 11 7"/></svg>
                                <div><strong>Two people sign off</strong><span>Maker and checker, always</span></div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- featured products -->
                <section class="pw-section" t-if="pw_products">
                    <div class="container">
                        <div class="text-center mb-5">
                            <span class="pw-pill">The DEMO shop</span>
                            <h2 class="mt-3">Teas and blends</h2>
                            <p class="pw-sub">Five fictional products, each chosen to show a different tax control. Add one to the basket and see the shop; open the back office to see why.</p>
                        </div>
                        <div class="row g-4">
                            <t t-foreach="pw_products" t-as="p">
                                <div class="col-6 col-md-4 col-lg">
                                    <a t-attf-href="/shop/#{slug(p)}" class="pw-card">
                                        <img t-attf-src="/web/image/product.template/#{p.id}/image_512" t-att-alt="p.name" loading="lazy"/>
                                        <div class="pw-card-body">
                                            <h3 t-out="p.name"/>
                                            <span class="pw-price" t-out="p.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                        <div class="text-center mt-5"><a href="/shop" class="btn btn-outline-primary">See the whole shop</a></div>
                    </div>
                </section>

                <!-- the three controls -->
                <section class="pw-section pw-section-sand">
                    <div class="container">
                        <div class="text-center mb-5">
                            <span class="pw-pill">Behind the shop</span>
                            <h2 class="mt-3">Three controls, one standard build</h2>
                            <p class="pw-sub">Built on standard Odoo 19 Community. Settings first, automation second, custom code only where nothing standard fits.</p>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="pw-control">
                                    <div class="pw-ico"><svg viewBox="0 0 28 28"><path d="M6 4h12l4 4v16H6z"/><path d="M18 4v4h4M10 14h8M10 18h8"/></svg></div>
                                    <h3>Tax Centre</h3>
                                    <p>Effective-dated, approved-only tax rules. A sale or invoice line with an unresolved treatment is blocked when it is confirmed, not corrected afterwards. Every posted tax event is permanent and fixed only by a reversal.</p>
                                    <p class="pw-tags">Approved · pending evidence · draft rule · missing evidence · overlapping rules · superseded · reversal</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="pw-control">
                                    <div class="pw-ico"><svg viewBox="0 0 28 28"><path d="M4 9h16l-4-4M24 19H8l4 4"/></svg></div>
                                    <h3>Reconciliation Hub</h3>
                                    <p>Courier batches, gateway payouts and bank lines matched by exact reference first, then by batch, then by amount and date, flagged low confidence. A difference becomes an exception with an owner, a note and a second approver. Nothing is written off automatically.</p>
                                    <p class="pw-tags">Clean batch · short settlement · unidentified credit · amount difference · ambiguous match · low confidence</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="pw-control">
                                    <div class="pw-ico"><svg viewBox="0 0 28 28"><path d="M4 10 14 4l10 6v10l-10 6-10-6z"/><path d="M4 10l10 6 10-6M14 16v10"/></svg></div>
                                    <h3>Distribution Partner</h3>
                                    <p>A stock roll-forward for every product and lot: opening, received, issued, returned, expired and reported. Each gap raises an exception. Custody is always recorded; revenue follows only an approved commercial model.</p>
                                    <p class="pw-tags">No variance · shortfall · surplus · commercial model awaiting sign-off</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- demo disclosure -->
                <section class="pw-section">
                    <div class="container">
                        <div class="pw-note">
                            <div class="row align-items-center g-4">
                                <div class="col-lg-7">
                                    <span class="pw-pill">Please read</span>
                                    <h2 class="mt-3">A demonstration, clearly marked</h2>
                                    <p class="mb-0">
                                        Pharma Demo Co, its products, prices, customers, tax rates, bank lines and partner stock are
                                        all fictional and flagged <strong>DEMO</strong>. Nothing on this site is medical or health
                                        advice, and no product makes any health claim. The database is neutralized: no e-mail is sent
                                        and no payment provider is active, so checkout stops at the payment step by design.
                                    </p>
                                </div>
                                <div class="col-lg-5 text-lg-end">
                                    <a href="/shop" class="btn btn-light btn-lg">Browse the shop</a>
                                    <p class="small mt-3 mb-0" style="color:#b9ccbd">Built on Odoo 19 Community by C2P Consultants.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="pharma_home_page" model="website.page">
        <field name="name">Pharma DEMO home</field>
        <field name="url">/pharma</field>
        <field name="view_id" ref="pharma_home"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="False"/>
    </record>
</odoo>
