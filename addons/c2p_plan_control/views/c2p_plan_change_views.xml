<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c2p_plan_change_list" model="ir.ui.view">
        <field name="name">c2p.plan.change.list</field>
        <field name="model">c2p.plan.change</field>
        <field name="arch" type="xml">
            <list string="Plan Changes" decoration-muted="state == 'rejected'">
                <field name="reference"/>
                <field name="change_type"/>
                <field name="affected_deliverables"/>
                <field name="project_id" optional="show"/>
                <field name="reason"/>
                <field name="previous_value" string="Was"/>
                <field name="new_value" string="Now"/>
                <field name="baseline_deadline" optional="show"/>
                <field name="proposed_by_id"/>
                <field name="proposed_on" optional="show"/>
                <field name="decided_by_id"/>
                <field name="decided_on" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'proposed'"
                       decoration-info="state == 'escalated'"
                       decoration-danger="state == 'rejected'"/>
                <field name="direct_edit" optional="hide"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_c2p_plan_change_form" model="ir.ui.view">
        <field name="name">c2p.plan.change.form</field>
        <field name="model">c2p.plan.change</field>
        <field name="arch" type="xml">
            <form string="Plan Change">
                <header>
                    <!-- Saving is the proposal. A labelled button says so; the
                         small save icon alone was easy to miss. -->
                    <button name="action_submit_proposal" type="object"
                            string="Submit Proposal" class="btn-primary" invisible="id"/>
                    <button name="action_approve" type="object" string="Approve and Apply"
                            class="btn-primary"
                            invisible="state != 'proposed' or change_type == 'scope' or not id"
                            groups="c2p_project_tracker.group_c2p_delivery_lead"/>
                    <button name="action_send_to_consultants" type="object"
                            string="Send to Consultants" class="btn-primary"
                            invisible="state != 'proposed' or change_type != 'scope' or not id"
                            groups="c2p_project_tracker.group_c2p_delivery_lead"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'proposed' or not id"
                            groups="c2p_project_tracker.group_c2p_delivery_lead"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,approved"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status"
                         invisible="change_type != 'scope' or state != 'proposed'">
                        A scope, price or contract change is decided by C2P Consultants.
                        The delivery owner reviews it and sends it on; the plan does not
                        change until Consultants approve.
                    </div>
                    <div class="oe_title">
                        <h2><field name="reference" readonly="1" placeholder="New plan change"/></h2>
                    </div>
                    <group>
                        <group string="What is proposed">
                            <field name="change_type" readonly="state != 'proposed'"/>
                            <field name="task_id" readonly="state != 'proposed'"
                                   options="{'no_create': True}"/>
                            <field name="milestone_id" readonly="state != 'proposed'"
                                   invisible="task_id" options="{'no_create': True}"/>
                            <field name="new_deadline" readonly="state != 'proposed'"
                                   invisible="change_type != 'date'"
                                   required="change_type == 'date'"/>
                            <field name="new_user_id" readonly="state != 'proposed'"
                                   invisible="change_type != 'reassign'"
                                   required="change_type == 'reassign'"/>
                            <field name="reason" readonly="state != 'proposed'"
                                   placeholder="Why the plan should change"/>
                            <field name="details" readonly="state != 'proposed'"
                                   invisible="change_type not in ('task', 'scope')"/>
                        </group>
                        <group string="Record">
                            <field name="affected_deliverables"/>
                            <field name="project_id"/>
                            <field name="proposed_by_id"/>
                            <field name="proposed_on"/>
                            <field name="previous_value" string="Previous value" invisible="state == 'proposed'"/>
                            <field name="new_value" string="New value" invisible="state == 'proposed'"/>
                            <field name="baseline_deadline" invisible="not baseline_deadline"/>
                            <field name="decided_by_id" invisible="state == 'proposed'"/>
                            <field name="decided_on" invisible="state == 'proposed'"/>
                            <field name="decision_note" readonly="state != 'proposed'"
                                   groups="c2p_project_tracker.group_c2p_delivery_lead"/>
                            <field name="change_request_id" invisible="not change_request_id"/>
                            <field name="change_request_state" invisible="not change_request_id"/>
                            <field name="direct_edit" invisible="not direct_edit"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_c2p_plan_change_search" model="ir.ui.view">
        <field name="name">c2p.plan.change.search</field>
        <field name="model">c2p.plan.change</field>
        <field name="arch" type="xml">
            <search string="Plan Changes">
                <field name="reference"/>
                <field name="task_id"/>
                <field name="milestone_id"/>
                <field name="project_id"/>
                <field name="proposed_by_id"/>
                <filter name="awaiting" string="Awaiting decision" domain="[('state', '=', 'proposed')]"/>
                <filter name="with_consultants" string="With Consultants" domain="[('state', '=', 'escalated')]"/>
                <filter name="mine" string="Proposed by me" domain="[('proposed_by_id', '=', uid)]"/>
                <filter name="direct" string="Direct edits" domain="[('direct_edit', '=', True)]"/>
                <group>
                    <filter name="by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_c2p_plan_change_mine" model="ir.actions.act_window">
        <field name="name">My Proposed Changes</field>
        <field name="res_model">c2p.plan.change</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You have not proposed any plan changes</p>
            <p>Open one of your tasks and choose Propose Plan Change when a date,
               an assignee or the scope needs to change.</p>
        </field>
    </record>
    <record id="action_c2p_plan_change_awaiting" model="ir.actions.act_window">
        <field name="name">Proposed Changes</field>
        <field name="res_model">c2p.plan.change</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_awaiting': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No plan changes are waiting for a decision</p>
        </field>
    </record>
    <record id="action_c2p_plan_change_history" model="ir.actions.act_window">
        <field name="name">Plan Change History</field>
        <field name="res_model">c2p.plan.change</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_c2p_decisions_awaiting" model="ir.actions.act_window">
        <field name="name">Change Requests Awaiting Decision</field>
        <field name="res_model">c2p.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('draft', 'submitted'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No change requests are waiting for you</p>
        </field>
    </record>
</odoo>
