<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_c2p_plan_control" model="ir.ui.view">
        <field name="name">project.task.form.c2p.plan.control</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_c2p_propose_plan_change" type="object"
                        string="Propose Plan Change" invisible="not id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="c2p_plan" string="Acceptance &amp; Plan Changes">
                    <group>
                        <field name="c2p_acceptance_criteria"
                               placeholder="How this work will be judged done"/>
                    </group>
                    <field name="c2p_plan_change_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="reference"/>
                            <field name="change_type"/>
                            <field name="reason"/>
                            <field name="previous_value" string="Was"/>
                            <field name="new_value" string="Now"/>
                            <field name="proposed_by_id"/>
                            <field name="decided_by_id"/>
                            <field name="decided_on"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'approved'"
                                   decoration-warning="state == 'proposed'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_milestone_form_c2p_plan_control" model="ir.ui.view">
        <field name="name">project.milestone.form.c2p.plan.control</field>
        <field name="model">project.milestone</field>
        <field name="inherit_id" ref="project.project_milestone_view_form"/>
        <field name="arch" type="xml">
            <field name="deadline" position="after">
                <field name="c2p_baseline_deadline" readonly="1"
                       invisible="not c2p_baseline_deadline"/>
            </field>
        </field>
    </record>
</odoo>
