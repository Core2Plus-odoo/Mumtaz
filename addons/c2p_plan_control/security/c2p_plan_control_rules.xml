<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_plan_change_company" model="ir.rule">
            <field name="name">Plan change: allowed companies</field>
            <field name="model_id" ref="model_c2p_plan_change"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- A contributor sees the changes they proposed. The delivery owner
             sees every change in their companies. -->
        <record id="rule_plan_change_own" model="ir.rule">
            <field name="name">Plan change: contributor sees own proposals</field>
            <field name="model_id" ref="model_c2p_plan_change"/>
            <field name="domain_force">[('proposed_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        </record>
        <record id="rule_plan_change_lead" model="ir.rule">
            <field name="name">Plan change: delivery owner sees all</field>
            <field name="model_id" ref="model_c2p_plan_change"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('c2p_project_tracker.group_c2p_delivery_lead'))]"/>
        </record>
    </data>
</odoo>
