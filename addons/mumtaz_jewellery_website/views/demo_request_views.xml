<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_request_list" model="ir.ui.view">
        <field name="name">jewellery.demo.request.list</field>
        <field name="model">jewellery.demo.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
                <field name="company_name"/>
                <field name="contact_name"/>
                <field name="country"/>
                <field name="stores"/>
                <field name="lang"/>
                <field name="state"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>
    <record id="view_demo_request_form" model="ir.ui.view">
        <field name="name">jewellery.demo.request.form</field>
        <field name="model">jewellery.demo.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group string="Who">
                            <field name="company_name"/>
                            <field name="contact_name"/>
                            <field name="role"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="country"/>
                            <field name="stores"/>
                        </group>
                        <group string="Provenance">
                            <field name="lang"/>
                            <field name="source_page"/>
                            <field name="consent_at"/>
                            <field name="consent_text"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_demo_request" model="ir.actions.act_window">
        <field name="name">Jawhar demo requests</field>
        <field name="res_model">jewellery.demo.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_demo_request" name="Jawhar demo requests" parent="crm.crm_menu_sales"
              action="action_demo_request" sequence="90" groups="sales_team.group_sale_manager"/>
</odoo>
