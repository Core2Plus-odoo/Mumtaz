<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="mail_template_appointment_confirmation" model="mail.template">
      <field name="name">Appointment: Confirmation</field>
      <field name="model_id" ref="model_c2p_appointment_booking"/>
      <field name="subject">Your {{ object.appointment_type_id.name }} is confirmed</field>
      <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
      <field name="email_to">{{ object.email }}</field>
      <field name="auto_delete" eval="False"/>
      <field name="body_html" type="html">
<div style="margin:0;padding:0;background:#f4f6fa;">
  <div style="max-width:600px;margin:0 auto;padding:28px 18px;font-family:Inter,Arial,Helvetica,sans-serif;color:#0B1B33;">
    <div style="background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(11,27,51,.07);">
      <div style="background:#002F6C;padding:26px 30px;">
        <div style="color:#ffffff;font-size:19px;font-weight:700;letter-spacing:-.01em;">Your meeting is confirmed</div>
        <div style="color:rgba(255,255,255,.72);font-size:13px;margin-top:4px;">C2P Group</div>
      </div>
      <div style="padding:30px;">
        <p style="margin:0 0 18px;font-size:15px;">Hello <t t-out="object.name or ''"/>,</p>
        <p style="margin:0 0 22px;font-size:15px;line-height:1.6;color:#39424e;">
          Thank you for booking. Here are the details:
        </p>
        <div style="background:#f4f6fa;border-left:4px solid #FFD700;border-radius:10px;padding:18px 20px;margin-bottom:24px;">
          <div style="font-weight:650;font-size:15px;margin-bottom:8px;" t-out="object.appointment_type_id.name or ''"/>
          <div style="font-size:14px;color:#39424e;margin-bottom:5px;" t-out="object.local_start_string() or ''"/>
          <div style="font-size:13px;color:#6b7684;" t-out="object.appointment_type_id.location or ''"/>
          <t t-if="object.staff_id">
            <div style="font-size:13px;color:#6b7684;margin-top:5px;">With <t t-out="object.staff_id.name or ''"/></div>
          </t>
        </div>
        <t t-if="object.notes">
          <p style="margin:0 0 8px;font-size:13px;font-weight:650;color:#39424e;">What you'd like to discuss</p>
          <p style="margin:0 0 24px;font-size:14px;color:#5b6472;line-height:1.6;" t-out="object.notes or ''"/>
        </t>
        <div style="margin:26px 0 8px;">
          <a t-attf-href="{{ object.get_base_url() }}/appointment/ics/{{ object.access_token }}"
             style="display:inline-block;background:#002F6C;color:#ffffff;text-decoration:none;padding:12px 26px;border-radius:999px;font-weight:650;font-size:14px;">
            Add to your calendar
          </a>
        </div>
        <p style="margin:22px 0 0;font-size:13px;color:#8a929e;line-height:1.6;">
          Need to change or cancel?
          <a t-attf-href="{{ object.get_base_url() }}/appointment/cancel/{{ object.access_token }}"
             style="color:#002F6C;">Cancel this booking</a>
          and pick another time.
        </p>
      </div>
      <div style="background:#f4f6fa;padding:18px 30px;font-size:12px;color:#8a929e;">
        C2P Group &#183; Ajman, UAE &#183; Karachi, Pakistan<br/>
        <a href="tel:+971581282057" style="color:#8a929e;">+971 58 128 2057</a> &#183;
        <a href="mailto:info@core2plus.com" style="color:#8a929e;">info@core2plus.com</a>
      </div>
    </div>
  </div>
</div>
      </field>
    </record>
  </data>
</odoo>
