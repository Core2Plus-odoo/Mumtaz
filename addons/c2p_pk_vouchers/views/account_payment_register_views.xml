<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_c2p_wht" model="ir.ui.view">
        <field name="name">account.payment.register.form.c2p.wht</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="apply_wht"/>
                <field name="wht_tax_id" invisible="not apply_wht"
                       options="{'no_create': True}"/>
                <field name="wht_base" invisible="not apply_wht"/>
                <field name="wht_amount" invisible="not apply_wht" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
