<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c2p_payment_voucher_form" model="ir.ui.view">
        <field name="name">c2p.payment.voucher.form</field>
        <field name="model">c2p.payment.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment / Receipt Voucher">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="payment_type" widget="radio"/>
                        <field name="partner_id"/>
                        <field name="journal_id"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="cheque_no"/>
                        <field name="cheque_date"/>
                        <field name="memo"/>
                        <field name="is_intercompany"/>
                        <field name="is_bank_transfer"/>
                    </group>
                </group>

                <group invisible="not is_intercompany">
                    <group string="This Company">
                        <field name="intercompany_account_id"/>
                        <field name="amount"/>
                    </group>
                    <group string="Mirror in Other Company (optional)">
                        <field name="dest_company_id" options="{'no_create': True}"/>
                        <field name="dest_bank_journal_id"
                               invisible="not dest_company_id"
                               required="dest_company_id"/>
                        <field name="dest_intercompany_account_id"
                               invisible="not dest_company_id"
                               required="dest_company_id"/>
                    </group>
                </group>

                <group string="Interbank Transfer (same company)"
                       invisible="not is_bank_transfer">
                    <field name="dest_journal_id"/>
                    <field name="amount"/>
                </group>

                <div invisible="is_intercompany or is_bank_transfer">
                    <button name="action_load_open_items" type="object"
                            string="Load Open Items" class="btn-secondary"/>
                    <field name="line_ids">
                        <list editable="bottom" create="false">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="invoice_date"/>
                            <field name="name"/>
                            <field name="ref"/>
                            <field name="amount_total"/>
                            <field name="residual"/>
                            <field name="to_pay"/>
                            <field name="wht_it" string="Income WHT"/>
                            <field name="wht_st" string="Sales WHT"/>
                            <field name="net_pay" string="Net"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="wht_it_tax_id"
                                   options="{'no_create': True}"/>
                            <field name="wht_st_tax_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group class="oe_subtotal_footer">
                            <field name="total_selected"/>
                            <field name="wht_it_amount"/>
                            <field name="wht_st_amount"/>
                            <field name="net_amount"/>
                        </group>
                    </group>
                </div>

                <footer>
                    <button name="action_post" type="object" string="Post Voucher"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_c2p_payment_voucher" model="ir.actions.act_window">
        <field name="name">Payment / Receipt Voucher</field>
        <field name="res_model">c2p.payment.voucher</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_c2p_payment_voucher"
              name="Payment / Receipt Voucher"
              parent="account.menu_finance"
              action="action_c2p_payment_voucher"
              sequence="6"/>
</odoo>
