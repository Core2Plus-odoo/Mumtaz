<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_voucher" model="report.paperformat">
        <field name="name">C2P Voucher A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_voucher" model="ir.actions.report">
        <field name="name">Voucher</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">c2p_pk_vouchers.report_voucher</field>
        <field name="report_file">c2p_pk_vouchers.report_voucher</field>
        <field name="paperformat_id" ref="paperformat_voucher"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Voucher - %s' % ((object.name or '').replace('/', '-'))</field>
    </record>

    <record id="action_report_voucher_knockoff" model="ir.actions.report">
        <field name="name">Voucher - Invoices Knocked-off</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">c2p_pk_vouchers.report_voucher_knockoff</field>
        <field name="report_file">c2p_pk_vouchers.report_voucher_knockoff</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Knock-off - %s' % ((object.name or '').replace('/', '-'))</field>
    </record>
</odoo>
