<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_voucher" model="ir.actions.report">
        <field name="name">Voucher</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">c2p_pk_vouchers.report_voucher</field>
        <field name="report_file">c2p_pk_vouchers.report_voucher</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Voucher - %s' % ((object.name or '').replace('/', '-'))</field>
    </record>

    <record id="action_report_voucher_knockoff" model="ir.actions.report">
        <field name="name">Voucher - Invoices Knocked-off</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">c2p_pk_vouchers.report_voucher_knockoff</field>
        <field name="report_file">c2p_pk_vouchers.report_voucher_knockoff</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Knock-off - %s' % ((object.name or '').replace('/', '-'))</field>
    </record>
</odoo>
