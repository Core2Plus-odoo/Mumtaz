<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Minutes are visible to the people they concern: the chair, the
             attendees, the project's manager, and whoever wrote them. Not to
             every project user in the database, because minutes routinely
             carry commercial and personnel discussion. -->
        <record id="rule_c2p_meeting_participant" model="ir.rule">
            <field name="name">Meetings: chair, attendees, project manager and author</field>
            <field name="model_id" ref="model_c2p_meeting"/>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="domain_force">['|','|','|',
                ('organiser_id','=',user.id),
                ('create_uid','=',user.id),
                ('attendee_ids','in',[user.partner_id.id]),
                ('project_id.user_id','=',user.id)]</field>
        </record>

        <!-- Project managers see every set of minutes in their allowed
             companies: oversight is the point of the role. -->
        <record id="rule_c2p_meeting_manager" model="ir.rule">
            <field name="name">Meetings: project managers see their companies</field>
            <field name="model_id" ref="model_c2p_meeting"/>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>

        <!-- Action items follow their minutes rather than carrying their own
             visibility logic: one answer to "who may see this meeting". -->
        <record id="rule_c2p_meeting_action_participant" model="ir.rule">
            <field name="name">Meeting actions: follow the minutes</field>
            <field name="model_id" ref="model_c2p_meeting_action"/>
            <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
            <field name="domain_force">['|','|','|','|',
                ('user_id','=',user.id),
                ('meeting_id.organiser_id','=',user.id),
                ('meeting_id.create_uid','=',user.id),
                ('meeting_id.attendee_ids','in',[user.partner_id.id]),
                ('meeting_id.project_id.user_id','=',user.id)]</field>
        </record>

        <record id="rule_c2p_meeting_action_manager" model="ir.rule">
            <field name="name">Meeting actions: project managers see their companies</field>
            <field name="model_id" ref="model_c2p_meeting_action"/>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
            <field name="domain_force">[('company_id','in',company_ids)]</field>
        </record>
    </data>
</odoo>
