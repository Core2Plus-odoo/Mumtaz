<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_c2p_meeting_action_list" model="ir.ui.view">
        <field name="name">c2p.meeting.action.list</field>
        <field name="model">c2p.meeting.action</field>
        <field name="arch" type="xml">
            <list string="Action Items" decoration-muted="state == 'rejected'">
                <field name="reference"/>
                <field name="name"/>
                <field name="meeting_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'converted'"
                       decoration-warning="state == 'proposed'"
                       decoration-danger="state == 'rejected'"/>
                <field name="task_id" optional="show"/>
                <field name="task_state" optional="hide"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_c2p_meeting_action_form" model="ir.ui.view">
        <field name="name">c2p.meeting.action.form</field>
        <field name="model">c2p.meeting.action</field>
        <field name="arch" type="xml">
            <form string="Action Item">
                <header>
                    <button name="action_propose" type="object" string="Propose"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            groups="c2p_meeting_actions.group_c2p_meeting_approver"
                            invisible="state not in ('draft','proposed')"/>
                    <button name="action_create_task" type="object"
                            string="Create Task" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_open_task" type="object"
                            string="Open Task" invisible="not task_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,proposed,approved,converted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="name" placeholder="What has to happen"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="meeting_id"/>
                            <field name="user_id"/>
                            <field name="date_deadline"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="milestone_id" invisible="not project_id"/>
                            <field name="parent_task_id" invisible="not project_id"/>
                            <field name="task_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Approval">
                        <group>
                            <field name="proposed_by_id" readonly="1"/>
                            <field name="proposed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                            <field name="rejection_reason" readonly="1"
                                   invisible="state != 'rejected'"/>
                        </group>
                    </group>
                    <group string="Context">
                        <field name="notes" nolabel="1"
                               placeholder="Anything the owner needs to know"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_c2p_meeting_action" model="ir.actions.act_window">
        <field name="name">Meeting Actions</field>
        <field name="res_model">c2p.meeting.action</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_c2p_meeting_action_mine" model="ir.actions.act_window">
        <field name="name">My Meeting Actions</field>
        <field name="res_model">c2p.meeting.action</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id','=',uid),('state','!=','rejected')]</field>
    </record>
</odoo>
