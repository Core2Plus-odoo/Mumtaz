<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!--
    A piece out on approval is still yours: not sold, not delivered, and it
    must stay in your valuation. But it is not on your shelf, and a shop
    count that expects to find it will not balance. So it moves to an
    INTERNAL location, never to a customer location. Ownership and valuation
    are unchanged; the shop's on-hand drops; and the approval location can be
    reported on separately, which is what "on your book, not on your shelf"
    means on the owner view.
  -->
  <record id="location_on_approval" model="stock.location">
    <field name="name">On approval</field>
    <field name="usage">internal</field>
    <field name="location_id" ref="stock.stock_location_locations"/>
    <field name="comment">Pieces with a client on approval. Still owned and still valued; simply not on the shelf.</field>
  </record>
</odoo>
