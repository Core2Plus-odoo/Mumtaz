<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharma_tax_event_list" model="ir.ui.view">
        <field name="name">pharma.tax.event.list</field>
        <field name="model">pharma.tax.event</field>
        <field name="arch" type="xml">
            <list string="Tax Events" create="0" edit="0" delete="0" decoration-muted="kind == 'reversal'">
                <field name="order_ref"/><field name="channel"/><field name="settlement_ref"/>
                <field name="tax_type"/><field name="kind"/>
                <field name="base" sum="Base"/><field name="amount" sum="Tax"/>
                <field name="rule_code"/><field name="is_demo" string="DEMO"/>
            </list>
        </field>
    </record>
    <record id="view_pharma_tax_event_form" model="ir.ui.view">
        <field name="name">pharma.tax.event.form</field>
        <field name="model">pharma.tax.event</field>
        <field name="arch" type="xml">
            <form string="Tax Event" create="0" edit="0" delete="0">
                <header>
                    <button name="action_reverse" type="object" string="Reverse" invisible="kind == 'reversal'"
                            groups="pharma_core.group_pharma_finance"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_ref"/><field name="channel"/><field name="settlement_ref"/>
                            <field name="tax_type"/><field name="kind"/><field name="reversal_of"/>
                        </group>
                        <group string="Rule snapshot at posting (immutable)">
                            <field name="rule_id"/><field name="rule_code"/><field name="rate"/>
                            <field name="legal_ref"/><field name="evidence_ref"/><field name="approved_by_name"/>
                            <field name="base"/><field name="amount"/><field name="is_demo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pharma_tax_event_search" model="ir.ui.view">
        <field name="name">pharma.tax.event.search</field>
        <field name="model">pharma.tax.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_ref"/><field name="settlement_ref"/>
                <group>
                    <filter name="g_type" string="Tax type" context="{'group_by': 'tax_type'}"/>
                    <filter name="g_channel" string="Channel" context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_pharma_tax_event" model="ir.actions.act_window">
        <field name="name">Tax Events</field>
        <field name="res_model">pharma.tax.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_g_type': 1}</field>
    </record>
</odoo>
